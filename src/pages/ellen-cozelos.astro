---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";
import Button from "../components/Button.astro";
import { Image } from "astro:assets";
import { site } from "../data/site";
import { getImage } from "../lib/images";

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Company", href: "/company/" },
  { name: "Ellen Cozelos", href: "/ellen-cozelos/" },
];

const officeImg = getImage("CozeloOffice.webp");

const expertise = [
  {
    icon: "browser",
    title: "Software Engineering",
    body: "Two decades architecting secure, scalable systems for environments where failure isn't an option. For clients, that discipline becomes websites and platforms engineered to perform flawlessly — fast, reliable, and built to last.",
  },
  {
    icon: "shield",
    title: "Cyber Security",
    body: "A security-first mindset shaped by defense-grade standards. Every build is hardened from the ground up, protecting your data, your customers, and your reputation long before a threat ever appears.",
  },
  {
    icon: "bolt",
    title: "Artificial Intelligence",
    body: "Practical AI that does real work — assistants that capture leads around the clock, automations that return hours to your team, and content engineered to be found by the AI tools customers now ask first.",
  },
  {
    icon: "target",
    title: "Digital Marketing",
    body: "Technology means nothing if no one sees it. Ellen pairs engineering with marketing strategy — SEO, advertising, and content — so the systems she builds don't just exist, they generate measurable demand.",
  },
  {
    icon: "star",
    title: "Strategic Business Technology",
    body: "The rarest skill of all: translating complex technology into business outcomes. Ellen starts with your goals, then engineers the system that gets you there — turning innovation into growth you can measure.",
  },
];

const philosophy = [
  {
    n: "01",
    title: "Technology should solve business problems.",
    body: "Tools are never the point. The right technology, applied with intent, removes friction, wins customers, and moves the numbers that matter to your business.",
  },
  {
    n: "02",
    title: "Innovation should create opportunity.",
    body: "Done well, innovation isn't disruption for its own sake — it opens doors: new markets, new efficiencies, and new ways for a business to grow.",
  },
  {
    n: "03",
    title: "Strong partnerships produce the best results.",
    body: "The best outcomes come from genuine partnership — shared goals, honest communication, and a team that treats your success as its own.",
  },
  {
    n: "04",
    title: "Trust is earned through performance.",
    body: "Trust isn't claimed in a pitch; it's proven in delivery — on time, in writing, and engineered to the standard the work demands.",
  },
  {
    n: "05",
    title: "Long-term success comes from continuous improvement.",
    body: "An online presence should get stronger every quarter. Ellen builds for the long game — systems that are maintained, refined, and always improving.",
  },
];

const whyEllen = [
  { icon: "building", title: "Enterprise-level experience", body: "Standards forged on systems where precision and performance are non-negotiable." },
  { icon: "award", title: "Government & aerospace background", body: "Two decades supporting NASA and Department of Defense mission-critical software." },
  { icon: "target", title: "Strategic thinking", body: "Every decision starts with your business goals, not a template." },
  { icon: "bolt", title: "Business-focused solutions", body: "Technology engineered to produce leads, growth, and measurable ROI." },
  { icon: "chat", title: "Personalized service", body: "You work directly with Ellen — a partner, not a ticket queue." },
  { icon: "shield", title: "Long-term partnerships", body: "Invested in your results well beyond launch day, quarter after quarter." },
];

// Person schema — strengthens E-E-A-T by tying the founder's authority to the
// organization. Referenced as the org's founder via @id.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${site.url}/#ellen-cozelos`,
  name: "Ellen Cozelos",
  jobTitle: "Founder & Principal",
  description:
    "Founder of Cozelos Data — software engineer, cybersecurity specialist, AI specialist, and digital marketing professional with 20+ years across NASA, Department of Defense, aerospace, and commercial programs.",
  url: `${site.url}/ellen-cozelos/`,
  worksFor: { "@id": `${site.url}/#organization` },
  alumniOf: { "@type": "CollegeOrUniversity", name: "Columbia University" },
  knowsAbout: [
    "Software Engineering",
    "Cyber Security",
    "Artificial Intelligence",
    "Digital Marketing",
    "Emerging Technologies",
  ],
};
---
<BaseLayout
  title="Ellen Cozelos — Founder of Cozelos Data | Technology Leader"
  description="Ellen Cozelos founded Cozelos Data — software engineer, cybersecurity and AI leader, 20+ years across NASA and DoD, Master's from Columbia University."
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />

  <!-- Hero -->
  <PageHero
    eyebrow="Founder · Cozelos Data"
    title="Enterprise technology, brought home to the businesses that matter."
    lead="For more than 20 years, Ellen Cozelos built secure, mission-critical systems for NASA and the Department of Defense. Today she brings that same standard to businesses across Eastern Utah and beyond — because great technology shouldn't be reserved for the few."
    summary="Ellen Cozelos is the founder of Cozelos Data, a software engineer, cybersecurity specialist, AI specialist, and digital marketing professional with more than 20 years of experience across NASA, Department of Defense, aerospace, and commercial programs. She holds a Master's degree from Columbia University and brings enterprise-grade technology to businesses throughout Eastern Utah and beyond, guided by a simple principle: if it is important to our clients, it is important to us."
    breadcrumbs={breadcrumbs}
  >
    <!-- Founder card -->
    <div class="rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-7">
      <div class="flex items-center gap-4">
        <span class="grid h-16 w-16 place-items-center rounded-2xl bg-[var(--color-brand)] font-display text-xl font-extrabold text-white">EC</span>
        <div>
          <p class="font-display text-lg font-bold tracking-tight">Ellen Cozelos</p>
          <p class="text-sm text-[var(--text-muted)]">Founder &amp; Principal, Cozelos Data</p>
        </div>
      </div>
      {officeImg && (
        <div class="mt-6 overflow-hidden rounded-2xl border border-[var(--border)]">
          <Image
            src={officeImg}
            alt="Cozelos Data — founded by Ellen Cozelos in Vernal, Utah"
            widths={[400, 700]}
            sizes="(min-width: 1024px) 38vw, 92vw"
            loading="eager"
            decoding="async"
            format="webp"
            class="w-full object-cover"
          />
        </div>
      )}
      <p class="mt-6 border-l-2 border-[var(--color-brand)] pl-4 font-display text-base font-semibold leading-snug text-[var(--text)]">
        &ldquo;If it is important to our clients, it is important to us.&rdquo;
      </p>
      <Button href="/contact/" size="md" magnetic icon="arrow" class="mt-6 w-full justify-center">Schedule a Consultation</Button>
    </div>
  </PageHero>

  <!-- Executive Biography -->
  <Section eyebrow="The Story" title="The strategic leader behind Cozelos Data.">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="reveal space-y-5 text-lg leading-relaxed text-[var(--text-muted)] lg:col-span-8">
        <p class="font-display text-2xl font-extrabold leading-snug tracking-tight text-[var(--text)] sm:text-3xl">
          Technology is easy. Building trust is hard.
        </p>
        <p>
          Ellen Cozelos has spent her career on the hard part. More than the code,
          more than the credentials, she is the strategist clients rely on to turn
          complex technology into decisions that move a business forward — building
          for <span class="font-semibold text-[var(--text)]">consequence</span>,
          the kind of systems where a single line carries real weight and
          &ldquo;good enough&rdquo; was never an option.
        </p>
        <p>
          For more than two decades, Ellen supported mission-critical software
          development for <span class="font-semibold text-[var(--text)]">NASA and Department of Defense</span> programs:
          secure, reliable, scalable systems engineered for environments where
          precision and performance aren't features but requirements. From
          Huntsville, Alabama — a city synonymous with aerospace — she learned a
          standard of work that most of the commercial world rarely sees.
        </p>
        <p>
          Her path was never narrow. Across government, aerospace, and commercial
          sectors, Ellen became fluent in disciplines that usually live in
          separate departments: <span class="font-semibold text-[var(--text)]">software engineering, cybersecurity,
          artificial intelligence, digital marketing, and emerging technologies</span>.
          She earned a Master's degree from Columbia University and kept learning —
          because the technologies that move businesses forward never stop evolving.
        </p>
        <p>
          That rare combination is the reason Cozelos Data exists. Ellen founded
          the company on a conviction she'd felt for years: the businesses that
          power our communities — the contractors, clinics, hotels, and family
          shops — deserve the same caliber of technology as the agencies and
          enterprises she'd spent her career serving. Not a watered-down template.
          The real thing.
        </p>
        <p>
          What makes her a trusted advisor isn't only the technical depth — it's
          how she leads with it. Ellen believes the best results come from genuine
          partnership, and she operates by a principle that has guided every
          engagement of her career:
        </p>
        <p class="border-l-2 border-[var(--color-brand)] pl-5 font-display text-xl font-semibold text-[var(--text)]">
          &ldquo;If it is important to our clients, it is important to us.&rdquo;
        </p>
        <p>
          It's a simple line with serious implications. It means strategy before
          pixels, security before shortcuts, and a long-term commitment to seeing
          a client's business grow — not just shipping a website and moving on.
          For Ellen, technology was never the destination. It's the most powerful
          tool we have for making businesses stronger and life better.
        </p>
      </div>

      <!-- Pull-stats -->
      <aside class="reveal lg:col-span-4" data-delay="120">
        <div class="space-y-4 lg:sticky lg:top-28">
          {[
            { stat: "20+ yrs", label: "Delivering innovative technology solutions" },
            { stat: "NASA & DoD", label: "Mission-critical software programs" },
            { stat: "Columbia", label: "Master's degree" },
            { stat: "5 fields", label: "Engineering · Security · AI · Marketing · Strategy" },
          ].map((s) => (
            <div class="rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-6">
              <p class="font-display text-2xl font-extrabold tracking-tight text-gradient">{s.stat}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-muted)]">{s.label}</p>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </Section>

  <!-- Areas of Expertise -->
  <Section
    eyebrow="Areas of Expertise"
    title="Five disciplines. One unified advantage."
    lead="Most agencies are strong in one area. Ellen's command of five — and how they reinforce one another — is what turns a website into a system for growth."
  >
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {expertise.map((e, i) => (
        <div data-delay={i * 60} class="reveal group rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-7 transition-colors duration-300 hover:border-[var(--color-brand)]/40">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-[var(--color-brand)]/10 text-[var(--color-brand)] transition-all duration-300 group-hover:scale-110 group-hover:bg-[var(--color-brand)] group-hover:text-white">
            <Icon name={e.icon} size={22} />
          </span>
          <h3 class="mt-5 font-display text-lg font-bold tracking-tight">{e.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{e.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Leadership Philosophy -->
  <Section
    eyebrow="Leadership Philosophy"
    title="The convictions behind the work."
    lead="How Ellen leads is as deliberate as what she builds. Five principles guide every engagement."
  >
    <div class="grid gap-px overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--border)] lg:grid-cols-2">
      {philosophy.map((p, i) => (
        <div data-delay={i * 60} class="reveal bg-[var(--surface-2)] p-8 transition-colors duration-300 hover:bg-[var(--surface-3)]">
          <span class="font-mono text-sm font-semibold text-[var(--color-brand)]">{p.n}</span>
          <h3 class="mt-3 font-display text-lg font-bold leading-snug tracking-tight">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{p.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Why Clients Choose Ellen -->
  <Section
    eyebrow="Why Clients Choose Ellen"
    title="Enterprise expertise, with a personal hand on the work."
  >
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {whyEllen.map((w, i) => (
        <div data-delay={i * 50} class="reveal flex gap-4 rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-6">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-[var(--color-brand)]/10 text-[var(--color-brand)]">
            <Icon name={w.icon} size={22} />
          </span>
          <div>
            <h3 class="font-display text-base font-bold tracking-tight">{w.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-muted)]">{w.body}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="reveal mx-auto mt-10 max-w-2xl text-center leading-relaxed text-[var(--text-muted)]">
      Ellen has a hand on every engagement — see
      <a href="/portfolio/" class="font-semibold text-[var(--color-brand)] link-underline">the client work that has come out of it</a>.
    </p>
  </Section>

  <!-- Personal Mission -->
  <Section class="!pb-10">
    <div class="reveal mx-auto max-w-3xl rounded-3xl border border-[var(--color-brand)]/30 bg-[var(--surface-2)] p-10 text-center sm:p-14">
      <span class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--color-brand)]">Personal Mission</span>
      <p class="mt-5 font-display text-2xl font-extrabold leading-[1.2] tracking-tight sm:text-3xl">
        Technology is not the goal. It is the tool.
      </p>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-[var(--text-muted)]">
        For Ellen, the real mission was never the code. It's what the code makes
        possible: businesses that grow stronger, communities that become more
        resilient, and lives made better through thoughtful innovation and trusted
        partnership. Cozelos Data isn't a web design company. It's a strategic
        technology partner — built to help organizations strengthen their
        operations, protect what matters most, and create new opportunities for
        the people they serve.
      </p>
      <p class="mt-7 font-display text-xl font-bold tracking-tight">
        We Build Digital Assets That Grow Businesses.
      </p>
      <p class="mt-1 font-display text-lg font-semibold text-[var(--text-muted)]">
        Making Businesses Stronger. Making Life Better.
      </p>
    </div>
  </Section>

  <CTASection
    title="Let's build something that lasts."
    body="Start with a discovery consultation. Bring your goals; Ellen will bring two decades of enterprise expertise — and an honest plan to get you there."
    primaryLabel="Schedule a Consultation"
    secondaryLabel="Explore Cozelos Data"
    secondaryHref="/company/"
  />
</BaseLayout>
