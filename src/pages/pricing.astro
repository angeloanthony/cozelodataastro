---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import CTASection from "../components/CTASection.astro";
import Guarantees from "../components/Guarantees.astro";
import Icon from "../components/Icon.astro";
import Button from "../components/Button.astro";

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Investment", href: "/pricing/" },
];

// One-time project investments.
const tiers = [
  {
    name: "Essential Presence",
    price: "$2,500",
    prefix: "Starting at",
    suffix: "one-time",
    summary: "For businesses that need a professional, fast, credible presence — done right the first time.",
    features: [
      "Fully custom design — never a template",
      "Up to ~5 core pages",
      "Mobile-first, sub-second load times",
      "On-page SEO foundation",
      "Contact forms & analytics setup",
      "Google indexing & launch support",
    ],
    outcome: "Look established, load instantly, and start getting found.",
    highlight: false,
  },
  {
    name: "Professional Growth",
    price: "$4,500",
    prefix: "Starting at",
    suffix: "one-time",
    summary: "For growing businesses that want to actively win customers — not just exist online.",
    features: [
      "Everything in Essential Presence",
      "Expanded page architecture",
      "Advanced & local SEO with schema markup",
      "Conversion-focused copywriting",
      "Performance tuning & Core Web Vitals",
      "Content strategy & messaging",
    ],
    outcome: "Turn traffic into qualified leads and out-rank your local competition.",
    highlight: true,
  },
  {
    name: "Market Leader",
    price: "$7,500",
    prefix: "Starting at",
    suffix: "one-time",
    summary: "For businesses ready to dominate their market and become the obvious choice.",
    features: [
      "Everything in Professional Growth",
      "Large pillar-and-spoke architecture",
      "Custom functionality & interactive tools",
      "Video integration & cinematic motion",
      "Advanced analytics & AI automation",
      "Ongoing conversion strategy",
    ],
    outcome: "Own the top of search and build a brand customers trust on sight.",
    highlight: false,
  },
  {
    name: "Enterprise",
    price: "Custom",
    prefix: "$10,000–$30,000+",
    suffix: "scoped to fit",
    summary: "For government, multi-location, and complex builds with serious requirements.",
    features: [
      "Bespoke scope & architecture",
      "System & data integrations",
      "Compliance & accessibility (WCAG, CMS)",
      "Multi-site or multi-location builds",
      "Dedicated project team",
      "Priority support & SLAs",
    ],
    outcome: "A digital platform engineered to your exact operational needs.",
    highlight: false,
  },
];

// Monthly retainers — ongoing growth, not just upkeep.
const plans = [
  {
    name: "Maintenance",
    price: "$295",
    summary: "Keep your asset fast, secure, and online.",
    features: [
      "Hosting, SSL & uptime monitoring",
      "Security monitoring & daily backups",
      "Performance optimization",
      "Minor content edits",
      "Priority technical support",
    ],
    highlight: false,
  },
  {
    name: "SEO Growth",
    price: "$495",
    summary: "Everything in Maintenance, plus active search growth.",
    features: [
      "Everything in Maintenance",
      "Keyword tracking & technical SEO",
      "Google Business Profile optimization",
      "Monthly ranking reports",
      "Content recommendations",
    ],
    highlight: true,
  },
  {
    name: "Authority",
    price: "$795",
    summary: "Compounding content and links that build market authority.",
    features: [
      "Everything in SEO Growth",
      "New SEO articles each month",
      "Internal linking & content architecture",
      "Landing page creation",
      "Competitor analysis",
    ],
    highlight: false,
  },
  {
    name: "Full Marketing",
    price: "$1,500+",
    summary: "A complete, managed growth engine with paid acquisition.",
    features: [
      "Everything in Authority",
      "Google & Meta ad management",
      "Creative production & A/B testing",
      "Conversion-rate optimization",
      "A dedicated growth partner",
    ],
    highlight: false,
  },
];
---
<BaseLayout
  title="Investment & Pricing — Web Design Growth Plans, Vernal UT"
  description="Transparent, investment-grade pricing from Cozelos Data. Custom website projects from $2,500 and monthly growth plans from $295 — built to generate leads, authority, and lasting ROI."
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow="Investment"
    title="An investment in growth — priced for return."
    lead="We don't simply build websites — we create complete growth platforms engineered to generate leads, authority, and revenue for years. Here's how we structure that investment, and exactly what it's worth."
    summary="Cozelos Data, a digital agency in Vernal, Utah, prices work as an investment, not a commodity. Custom website projects start at $2,500 (Essential Presence), $4,500 (Professional Growth), and $7,500 (Market Leader), with Enterprise builds scoped from $10,000. Ongoing monthly growth plans run from $295 (Maintenance) to $1,500+ (Full Marketing). Every project begins with a $500 Discovery Session, credited toward your build."
    breadcrumbs={breadcrumbs}
  />

  <!-- Pricing philosophy -->
  <Section class="!pb-8">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="font-display text-xl font-semibold leading-relaxed tracking-tight text-[var(--text)] sm:text-2xl">
        The most expensive website is the cheap one that costs you customers.
      </p>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-[var(--text-muted)]">
        A bargain template that loads slowly, ranks nowhere, and converts no one
        isn't cheap — it's a recurring loss. A well-built growth platform is the
        opposite: it pays for itself in new business, then keeps earning for
        years. Below is what that investment looks like.
      </p>
    </div>
  </Section>

  <!-- Discovery Session — the entry point -->
  <Section class="!pt-8">
    <div class="reveal grid items-center gap-8 overflow-hidden rounded-3xl border border-[var(--color-brand)]/30 bg-[var(--surface-2)] p-8 sm:p-10 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <span class="inline-flex items-center gap-2 rounded-full bg-[var(--color-brand)]/10 px-3.5 py-1.5 text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-brand)]">
          Start here
        </span>
        <h2 class="mt-4 font-display text-2xl font-extrabold tracking-tight sm:text-3xl">Discovery Session</h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-[var(--text-muted)]">
          Every great build starts with strategy. In a focused working session we
          map your goals, your customers, and your competition — then hand you a
          clear plan and a fixed quote. It's the single highest-leverage hour
          you'll spend on your digital presence, and the fee is <strong class="text-[var(--text)]">credited in full</strong> toward your project when you move forward.
        </p>
      </div>
      <div class="lg:col-span-4">
        <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-7 text-center">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-subtle)]">Strategy & roadmap</p>
          <p class="mt-2 font-display text-4xl font-extrabold text-gradient">$500</p>
          <p class="mt-1 text-sm text-[var(--text-muted)]">Credited toward your build</p>
          <Button href="/contact/" size="md" magnetic icon="arrow" class="mt-5 w-full justify-center">Book a Session</Button>
        </div>
      </div>
    </div>
  </Section>

  <!-- One-time project tiers -->
  <Section
    eyebrow="Build the Asset"
    title="One-time project investments."
    lead="Choose the scope that matches your ambition. Every tier is fully custom, hand-built, fast, secure, and yours to own — no templates, no lock-ins."
  >
    <div class="grid gap-6 lg:grid-cols-4">
      {tiers.map((t, i) => (
        <div
          data-delay={i * 60}
          class:list={[
            "reveal relative flex flex-col rounded-3xl border p-7 transition-[transform,box-shadow] duration-300 hover:-translate-y-1",
            t.highlight
              ? "border-[var(--color-brand)] bg-[var(--surface-2)] shadow-xl shadow-[var(--color-brand)]/10"
              : "border-[var(--border)] bg-[var(--surface-2)]",
          ]}
        >
          {t.highlight && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-[var(--color-brand)] px-3 py-1 text-xs font-bold uppercase tracking-wider text-white">
              Most Popular
            </span>
          )}
          <h3 class="font-display text-lg font-bold tracking-tight">{t.name}</h3>
          <div class="mt-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-[var(--text-subtle)]">{t.prefix}</p>
            <p class="font-display text-3xl font-extrabold tracking-tight">{t.price}</p>
            <p class="text-xs text-[var(--text-subtle)]">{t.suffix}</p>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-[var(--text-muted)]">{t.summary}</p>
          <ul class="mt-5 flex-1 space-y-2.5">
            {t.features.map((f) => (
              <li class="flex items-start gap-2 text-sm text-[var(--text-muted)]">
                <span class="mt-0.5 grid h-4 w-4 shrink-0 place-items-center rounded-full bg-[var(--color-brand)]/15 text-[var(--color-brand)]"><Icon name="check" size={11} /></span>
                {f}
              </li>
            ))}
          </ul>
          <div class="mt-5 rounded-xl bg-[var(--surface-3)] p-3 text-xs leading-relaxed text-[var(--text-muted)]">
            <span class="font-semibold text-[var(--text)]">The payoff: </span>{t.outcome}
          </div>
          <Button
            href="/contact/"
            size="md"
            variant={t.highlight ? "primary" : "secondary"}
            icon="arrow"
            class="mt-6 w-full justify-center"
          >
            {t.name === "Enterprise" ? "Request a Quote" : "Get Started"}
          </Button>
        </div>
      ))}
    </div>
    <p class="reveal mt-6 text-center text-sm text-[var(--text-subtle)]">
      Every quote is fixed in writing before work begins. No "starting from" footnotes, no surprise invoices.
    </p>
  </Section>

  <!-- Monthly retainers -->
  <Section
    eyebrow="Grow the Asset"
    title="Monthly growth plans."
    lead="A website launched and forgotten quietly loses value. These plans keep yours fast, secure, and climbing — so the asset appreciates instead of decaying."
  >
    <div class="grid gap-6 lg:grid-cols-4">
      {plans.map((p, i) => (
        <div
          data-delay={i * 60}
          class:list={[
            "reveal relative flex flex-col rounded-3xl border p-7 transition-[transform,box-shadow] duration-300 hover:-translate-y-1",
            p.highlight
              ? "border-[var(--color-brand)] bg-[var(--surface-2)] shadow-xl shadow-[var(--color-brand)]/10"
              : "border-[var(--border)] bg-[var(--surface-2)]",
          ]}
        >
          {p.highlight && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-[var(--color-brand)] px-3 py-1 text-xs font-bold uppercase tracking-wider text-white">
              Most Popular
            </span>
          )}
          <h3 class="font-display text-lg font-bold tracking-tight">{p.name}</h3>
          <div class="mt-4 flex items-baseline gap-1">
            <span class="font-display text-3xl font-extrabold tracking-tight">{p.price}</span>
            <span class="text-sm text-[var(--text-subtle)]">/month</span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">{p.summary}</p>
          <ul class="mt-5 flex-1 space-y-2.5">
            {p.features.map((f) => (
              <li class="flex items-start gap-2 text-sm text-[var(--text-muted)]">
                <span class="mt-0.5 grid h-4 w-4 shrink-0 place-items-center rounded-full bg-[var(--color-brand)]/15 text-[var(--color-brand)]"><Icon name="check" size={11} /></span>
                {f}
              </li>
            ))}
          </ul>
          <Button
            href="/contact/"
            size="md"
            variant={p.highlight ? "primary" : "secondary"}
            icon="arrow"
            class="mt-6 w-full justify-center"
          >
            Choose {p.name}
          </Button>
        </div>
      ))}
    </div>
  </Section>

  <!-- Value reframe -->
  <Section
    eyebrow="The Real Math"
    title="Why a custom asset costs more — and returns more."
  >
    <div class="grid gap-6 lg:grid-cols-2">
      <div class="reveal rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-8">
        <p class="leading-relaxed text-[var(--text-muted)]">
          A custom Cozelos Data build isn't a generic theme stacked with plugins.
          It's a hand-engineered system that loads in under a second, has a far
          smaller attack surface, and needs less maintenance from day one. Every
          page is optimized for performance and search from the start — because
          the goal was never "a website." The goal is more customers.
        </p>
        <p class="mt-4 leading-relaxed text-[var(--text-muted)]">
          That's why we price by outcome, not by page count. You're not paying for
          pixels — you're investing in an asset that generates visibility,
          credibility, and revenue long after launch day.
        </p>
        <p class="mt-4 leading-relaxed text-[var(--text-muted)]">
          For a line-by-line look at what's actually being built, see
          <a href="/services/" class="font-semibold text-[var(--color-brand)] link-underline">what each of the six services includes</a>.
          Questions about timelines, ownership, or what happens after launch are
          answered in the <a href="/faq/" class="font-semibold text-[var(--color-brand)] link-underline">frequently asked questions</a>.
        </p>
      </div>
      <div class="reveal rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-8" data-delay="120">
        <h3 class="font-display text-lg font-bold tracking-tight">What your investment buys</h3>
        <ul class="mt-5 space-y-3">
          {[
            "An asset you own outright — domain, code, and content",
            "Sub-second speed that lifts rankings and lowers ad costs",
            "SEO and AI-search visibility that compounds over time",
            "A secure, low-maintenance build that ages well",
            "Fixed, transparent pricing with no surprise invoices",
            "A partner invested in your results, not just your launch",
          ].map((b) => (
            <li class="flex items-start gap-3 text-[var(--text-muted)]">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-[var(--color-brand)]/15 text-[var(--color-brand)]"><Icon name="check" size={13} /></span>
              {b}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <!-- De-risk the price: concrete guarantees right before the close -->
  <Guarantees />

  <CTASection
    title="Let's scope your investment."
    body="Start with a Discovery Session. We'll map the opportunity, recommend the right tier, and give you a fixed quote — credited toward your build."
    primaryLabel="Book a Discovery Session"
    secondaryLabel="See the Work"
  />
</BaseLayout>
