---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import CTASection from "../components/CTASection.astro";
import { faqs, faqCategories } from "../data/site";

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "FAQ", href: "/faq/" },
];

// Group the questions by category in the defined display order.
const grouped = faqCategories
  .map((category) => ({ category, items: faqs.filter((f) => f.category === category) }))
  .filter((g) => g.items.length > 0);

// One FAQPage schema covering all 25 questions on this page — matches what's
// rendered so the Q&As qualify for FAQ rich results and AI Overview citations.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<BaseLayout
  title="Frequently Asked Questions — Cozelos Data"
  description="Answers about pricing, timelines, ownership, SEO, hosting, maintenance, AI, video, and marketing from Cozelos Data — a premium digital agency in Vernal, Utah."
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />

  <PageHero
    eyebrow="Questions & Answers"
    title="Everything you actually want to ask."
    lead="Straight answers on pricing, timelines, ownership, SEO, hosting, maintenance, AI, video, and marketing — before you ever get on a call."
    summary="Common questions about working with Cozelos Data: custom website projects start at $2,500 with a $500 Discovery Session credited toward the build; most sites launch in 4–6 weeks; clients own their domain, code, and content outright; SEO typically improves rankings within 60–90 days; and monthly growth plans run from $295/month."
    breadcrumbs={breadcrumbs}
  />

  <Section class="!pt-4">
    <!-- Category quick-jump -->
    <nav aria-label="FAQ categories" class="reveal mb-12 flex flex-wrap gap-2.5">
      {grouped.map((g) => (
        <a
          href={`#${g.category.toLowerCase()}`}
          class="rounded-full border border-[var(--border-strong)] bg-[var(--surface-2)] px-4 py-2 text-sm font-semibold text-[var(--text-muted)] transition-colors hover:border-[var(--color-brand)] hover:text-[var(--color-brand)]"
        >
          {g.category}
        </a>
      ))}
    </nav>

    <div class="space-y-14">
      {grouped.map((g) => (
        <div id={g.category.toLowerCase()} class="scroll-mt-28">
          <h2 class="reveal font-display text-2xl font-extrabold tracking-tight">{g.category}</h2>
          <div class="reveal mt-5 divide-y divide-[var(--border)] overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--surface-2)]">
            {g.items.map((f, i) => (
              <details class="group" data-delay={i * 30} name={`faq-${g.category}`}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-display text-base font-semibold tracking-tight transition-colors hover:text-[var(--color-brand)] [&::-webkit-details-marker]:hidden">
                  {f.q}
                  <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-[var(--border)] text-[var(--text-muted)] transition-all duration-300 group-open:rotate-45 group-open:border-[var(--color-brand)] group-open:text-[var(--color-brand)]">
                    <span class="text-xl leading-none">+</span>
                  </span>
                </summary>
                <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-[var(--ease-out-quint)] group-open:grid-rows-[1fr]">
                  <div class="overflow-hidden">
                    <p class="px-6 pb-6 text-[15px] leading-relaxed text-[var(--text-muted)]">{f.a}</p>
                  </div>
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="reveal mx-auto mt-12 max-w-2xl text-center leading-relaxed text-[var(--text-muted)]">
      Several of these answers point at the work itself: here's
      <a href="/services/" class="font-semibold text-[var(--color-brand)] link-underline">what each of the six services covers</a>
      and <a href="/portfolio/" class="font-semibold text-[var(--color-brand)] link-underline">the client builds these answers describe</a>.
      The timeline and process questions above follow
      <a href="/our-approach/" class="font-semibold text-[var(--color-brand)] link-underline">the four stages every project moves through</a>.
    </p>
  </Section>

  <CTASection
    title="Still have a question?"
    body="If your question isn't answered here, ask us directly. We give straight answers — no pressure, no obligation."
    primaryLabel="Ask Us Anything"
    secondaryLabel="See Pricing"
    secondaryHref="/pricing/"
  />
</BaseLayout>
