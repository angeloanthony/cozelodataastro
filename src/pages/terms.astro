---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Terms", href: "/terms/" },
];
const updated = "January 2026";

const sections = [
  { h: "Agreement", p: "By engaging Cozelos Data for services or using this website, you agree to these terms. Project-specific terms, scope, and pricing are confirmed in a written proposal or invoice before any work begins, and those documents take precedence where they add detail." },
  { h: "Scope & estimates", p: "Quotes are based on the scope discussed at the time of estimate. Significant changes to scope may adjust timeline and cost; we will always confirm any change in writing before proceeding." },
  { h: "Payment terms", p: "Most projects are billed 50% to begin and 50% upon launch unless otherwise agreed. Maintenance plans are billed monthly. Invoices are due on receipt unless a different term is stated on the invoice." },
  { h: "Client ownership", p: "Upon final payment, you own the deliverables we create for you — your domain, hosting account, source code, and content. We use vendor-neutral, standard technologies and will transfer everything to you on request, with no proprietary lock-ins." },
  { h: "Revisions", p: "Our standard build includes two full design rounds plus unlimited minor copy and asset edits during the build phase. Work proceeds in approved milestones — design is approved before code, and code is approved before launch." },
  { h: "Warranties & liability", p: "We deliver our work with professional care, but we cannot guarantee specific search rankings or business outcomes, as these depend on factors outside our control. Our liability for any claim is limited to the amount paid for the services in question." },
  { h: "Maintenance & support", p: "Maintenance plans are optional and may be cancelled at any time. After cancellation you retain full ownership of your site and may host it anywhere. Support response times are described in your plan." },
  { h: "Termination", p: "Either party may end an engagement with written notice. You are responsible for payment for work completed up to the termination date, and we will hand off all completed deliverables you've paid for." },
];
---
<BaseLayout
  title="Terms of Service"
  description="The terms that govern Cozelos Data services and use of this website."
  breadcrumbs={breadcrumbs}
  noindex
>
  <PageHero eyebrow="Legal" title="Terms of Service" lead={`Last updated: ${updated}`} breadcrumbs={breadcrumbs} />

  <section class="container-x pb-20">
    <div class="reveal mx-auto max-w-3xl space-y-8">
      <p class="text-lg leading-relaxed text-[var(--text-muted)]">
        These terms govern your use of the {site.name} website and the services we provide. Please read them carefully.
      </p>
      {sections.map((s) => (
        <div>
          <h2 class="font-display text-xl font-bold tracking-tight">{s.h}</h2>
          <p class="mt-2 leading-relaxed text-[var(--text-muted)]">{s.p}</p>
        </div>
      ))}
      <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-6">
        <h2 class="font-display text-xl font-bold tracking-tight">Questions</h2>
        <p class="mt-2 leading-relaxed text-[var(--text-muted)]">
          For anything about these terms, email <a href={site.emailHref} class="font-semibold text-[var(--color-brand)] hover:underline">{site.email}</a> or call <a href={site.phoneHref} class="font-semibold text-[var(--color-brand)] hover:underline">{site.phone}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
