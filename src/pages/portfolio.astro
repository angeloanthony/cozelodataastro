---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import PortfolioGrid from "../components/PortfolioGrid.astro";
import AnimatedCounter from "../components/AnimatedCounter.astro";
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";
import { Image } from "astro:assets";
import { projects } from "../data/site";
import { getImage } from "../lib/images";
import afterImage from "../assets/portfolio/forebearfind.webp";

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Portfolio", href: "/portfolio/" },
];
const featured = projects.filter((p) => p.featured);
---
<BaseLayout
  title="Web Design Portfolio — Utah Business Websites"
  description="A growing roster of Utah business transformations: Forebear Find, 1908 Living, Adventure Tours Vernal, Best Western, Vernal Medicare, and more — custom design plus full SEO."
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow="Selected Work"
    title="Real businesses. Real transformations."
    lead="A growing roster of businesses we've moved from generic templates to modern digital systems. Every project includes custom design, full SEO architecture, and ongoing care."
    breadcrumbs={breadcrumbs}
  />

  <!-- Before / After slider -->
<Section
  eyebrow="Drag to Compare"
  title="Same business. Modern presence."
  lead="Drag the slider to see what a Cozelos build replaces."
  center
>
  <div
    id="ba-slider"
    class="reveal relative mx-auto aspect-[16/9] max-w-3xl cursor-ew-resize select-none overflow-hidden rounded-3xl border border-[var(--border)]"
  >
    <!-- After (right side - your image) -->
    <div 
      class="absolute inset-0 bg-cover bg-center"
      style={`background-image: url(${afterImage.src});`}
    >
      <div class="absolute inset-0 bg-gradient-to-br from-black/40 via-black/50 to-black/70"></div>
      <div class="relative h-full grid place-items-center text-center text-white">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-white/70">Cozelos Build</p>
          <p class="mt-2 font-display text-3xl font-extrabold">Sub-second · #1 ranked</p>
          <p class="mt-1 text-white/70">Conversion engine</p>
        </div>
      </div>
    </div>

    <!-- Before (left side) -->
    <div 
      id="ba-before"
      class="absolute inset-0 bg-cover bg-center bg-[var(--surface-3)]"
      style="clip-path: inset(0 50% 0 0);"
    >
      <div class="absolute inset-0 bg-gradient-to-br from-black/40 via-black/50 to-black/70"></div>
      <div class="relative h-full grid place-items-center text-center text-white">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em]">Before</p>
          <p class="mt-2 font-display text-3xl font-extrabold">8.2s · Page 7</p>
          <p class="mt-1">Static brochure</p>
        </div>
      </div>
    </div>

    <!-- Handle -->
    <div id="ba-handle" class="absolute inset-y-0 z-10 w-1 -translate-x-1/2 bg-white" style="left:50%;">
      <span class="absolute top-1/2 left-1/2 grid h-10 w-10 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white text-[var(--color-ink)] shadow-lg">
        <Icon name="arrow" size={16} class="rotate-180" />
      </span>
    </div>
  </div>
</Section>

  <!-- Project grid -->
  <Section
    eyebrow="The Roster"
    title="A growing portfolio."
    lead="Hover any project to see the stack, results, and a case-study link."
  >
    <PortfolioGrid />
  </Section>

  <!-- Featured case studies (deep dive) -->
  <Section eyebrow="Featured Case Studies" title="A closer look.">
    <div class="space-y-8">
      {featured.map((p) => {
        const img = p.image ? getImage(p.image) : undefined;
        return (
        <article id={p.slug} class="reveal grid gap-8 rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-7 lg:grid-cols-12 lg:p-10" style={`--accent:${p.accent}`}>
          <div class="lg:col-span-5">
            {img ? (
              <div class="aspect-video overflow-hidden rounded-2xl border border-[var(--border)]">
                <Image
                  src={img}
                  alt={`${p.name} — ${p.category} website by Cozelos Data`}
                  widths={[400, 600, 800]}
                  sizes="(min-width: 1024px) 38vw, 92vw"
                  loading="lazy"
                  decoding="async"
                  format="webp"
                  class="h-full w-full object-cover"
                />
              </div>
            ) : (
              <div class="aspect-video overflow-hidden rounded-2xl" style={`background: radial-gradient(120% 120% at 0% 0%, color-mix(in srgb, ${p.accent} 55%, #111827), #111827 60%);`}>
                <div class="p-6">
                  <div class="flex gap-1.5">
                    <span class="h-2.5 w-2.5 rounded-full bg-white/30"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
                  </div>
                  <div class="mt-6 space-y-2.5">
                    <div class="h-3 w-2/3 rounded-full bg-white/25"></div>
                    <div class="h-2 w-1/2 rounded-full bg-white/15"></div>
                  </div>
                </div>
              </div>
            )}
          </div>
          <div class="lg:col-span-7">
            <span class="text-xs font-bold uppercase tracking-[0.16em]" style={`color:${p.accent}`}>{p.category}</span>
            <h3 class="mt-2 font-display text-2xl font-extrabold tracking-tight">{p.name}</h3>
            <p class="mt-3 leading-relaxed text-[var(--text-muted)]">{p.overview}</p>

            <div class="mt-5 flex flex-wrap gap-2">
              {p.services.map((srv) => (
                <span class="rounded-full bg-[var(--surface-3)] px-3 py-1 text-xs font-semibold text-[var(--text-muted)]">{srv}</span>
              ))}
            </div>

            <div class="mt-6 grid grid-cols-3 gap-4 border-t border-[var(--border)] pt-6">
              {p.results.map((r) => (
                <div>
                  <div class="font-display text-2xl font-extrabold" style={`color:${p.accent}`}>{r.metric}</div>
                  <div class="mt-0.5 text-xs font-semibold uppercase tracking-wide text-[var(--text-subtle)]">{r.label}</div>
                </div>
              ))}
            </div>

            {p.liveUrl && (
              <a
                href={p.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-transform hover:-translate-y-0.5"
                style={`background:${p.accent}`}
              >
                Visit Website
                <Icon name="external" size={16} />
              </a>
            )}
          </div>
        </article>
        );
      })}
    </div>
  </Section>

  <!-- Aggregate stats -->
  <Section class="!py-16">
    <div class="reveal grid grid-cols-2 gap-8 rounded-[var(--radius-xl2)] border border-[var(--border)] bg-[var(--surface-2)] p-10 lg:grid-cols-4">
      <AnimatedCounter value={40} suffix="+" label="Sites Launched" />
      <AnimatedCounter value={1} suffix="M+" label="Views Delivered" />
      <AnimatedCounter value={200} suffix="+" label="Leads Created" />
      <AnimatedCounter value={100} suffix="%" label="Client Retention" />
    </div>
  </Section>

  <CTASection
    title="Want to be next?"
    body="Tell us about your business — we'll show you exactly what we'd build."
  />

  <script>
    function initBA() {
      const slider = document.getElementById("ba-slider");
      const before = document.getElementById("ba-before");
      const handle = document.getElementById("ba-handle");
      if (!slider || !before || !handle || slider.dataset.init) return;
      slider.dataset.init = "true";

      let dragging = false;
      const set = (clientX: number) => {
        const r = slider.getBoundingClientRect();
        const pct = Math.min(Math.max((clientX - r.left) / r.width, 0), 1);
        before.style.clipPath = `inset(0 ${100 - pct * 100}% 0 0)`;
        handle.style.left = `${pct * 100}%`;
      };
      const start = () => (dragging = true);
      const end = () => (dragging = false);
      const move = (e: MouseEvent | TouchEvent) => {
        if (!dragging) return;
        const x = "touches" in e ? e.touches[0].clientX : (e as MouseEvent).clientX;
        set(x);
      };
      slider.addEventListener("mousedown", start);
      slider.addEventListener("touchstart", start, { passive: true });
      window.addEventListener("mouseup", end);
      window.addEventListener("touchend", end);
      window.addEventListener("mousemove", move);
      window.addEventListener("touchmove", move, { passive: true });
      // Click-to-position.
      slider.addEventListener("click", (e) => set((e as MouseEvent).clientX));
    }
    document.addEventListener("astro:page-load", initBA);
  </script>
</BaseLayout>
