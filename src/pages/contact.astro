---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import ContactForm from "../components/ContactForm.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Contact", href: "/contact/" },
];

const mapQuery = encodeURIComponent(
  `${site.address.street}, ${site.address.city}, ${site.address.region} ${site.address.postal}`
);

const expect = [
  {
    icon: "chat",
    title: "We listen first",
    body: "We start by understanding your business, your customers, and what success actually looks like for you — before we ever talk about a single deliverable.",
  },
  {
    icon: "target",
    title: "We map the opportunity",
    body: "Together we identify where the real growth is hiding — the leads you're missing, the searches you're losing, and the fastest path to results.",
  },
  {
    icon: "doc",
    title: "You get a clear plan",
    body: "You leave with honest direction and a fixed quote — whether you build with us or not. No pressure, no obligation, no hard sell.",
  },
];
---
<BaseLayout
  title="Contact Cozelos Data — Let's Build Something That Lasts"
  description="Start a conversation with Cozelos Data in Vernal, Utah. The first conversation is about understanding your goals, not selling services. Call (435) 219-5120."
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow="Start the Conversation"
    title="Let's build something that lasts."
    lead="The first conversation isn't a sales pitch — it's about understanding your business, your goals, and what success looks like for you. Tell us where you want to go, and we'll show you how we'd help you get there."
    summary="Contact Cozelos Data, a premium digital agency in Vernal, Utah. The first conversation focuses on understanding your goals, not selling services — you'll leave with honest direction and a fixed quote, with no obligation. Call (435) 219-5120, email ellen.cozelos@cozelosdata.com, or send a message. We reply within one business day."
    breadcrumbs={breadcrumbs}
  />

  <!-- What to expect — consultative, no-pressure framing -->
  <Section
    eyebrow="What to Expect"
    title="A conversation about your goals — not our services."
    lead="The best work starts with understanding, not a pitch. Here's how the first conversation actually goes."
  >
    <div class="grid gap-6 sm:grid-cols-3">
      {expect.map((e, i) => (
        <div data-delay={i * 70} class="reveal rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-7">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-[var(--color-brand)]/10 text-[var(--color-brand)]"><Icon name={e.icon} size={22} /></span>
          <h3 class="mt-5 font-display text-lg font-bold tracking-tight">{e.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{e.body}</p>
        </div>
      ))}
    </div>

    <p class="reveal mx-auto mt-10 max-w-2xl text-center leading-relaxed text-[var(--text-muted)]">
      Want to arrive with context? Skim
      <a href="/pricing/" class="font-semibold text-[var(--color-brand)] link-underline">what a project typically costs</a>
      or read the
      <a href="/faq/" class="font-semibold text-[var(--color-brand)] link-underline">answers to the questions most businesses ask first</a>.
    </p>
  </Section>

  <Section class="!pt-4">
    <div class="grid gap-10 lg:grid-cols-12">
      <!-- Form -->
      <div class="reveal lg:col-span-7">
        <div id="contact-form" class="scroll-mt-28 rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-7 sm:p-9">
          <h2 class="font-display text-2xl font-extrabold tracking-tight">Tell us about your business</h2>
          <p class="mt-2 text-[var(--text-muted)]">The more we know about your goals, the more useful our first conversation will be. We reply within one business day — and there's no obligation, ever.</p>
          <div class="mt-7">
            <ContactForm />
          </div>
        </div>
      </div>

      <!-- Details -->
      <div class="reveal space-y-5 lg:col-span-5" data-delay="120">
        <!-- Quick actions -->
        <div class="rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-7">
          <h2 class="font-display text-xl font-bold tracking-tight">Prefer to talk now?</h2>
          <p class="mt-2 text-sm text-[var(--text-muted)]">Reach a real person — not a call center or a ticket queue.</p>
          <div class="mt-5 grid gap-3 sm:grid-cols-3">
            <a href={site.phoneHref} class="flex flex-col items-center gap-2 rounded-2xl border border-[var(--border)] bg-[var(--surface)] px-3 py-4 text-center transition-colors hover:border-[var(--color-brand)]">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-[var(--color-brand)]/10 text-[var(--color-brand)]"><Icon name="phone" size={18} /></span>
              <span class="text-sm font-semibold text-[var(--text)]">Call</span>
            </a>
            <a href={site.smsHref} class="flex flex-col items-center gap-2 rounded-2xl border border-[var(--border)] bg-[var(--surface)] px-3 py-4 text-center transition-colors hover:border-[var(--color-brand)]">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-[var(--color-brand)]/10 text-[var(--color-brand)]"><Icon name="chat" size={18} /></span>
              <span class="text-sm font-semibold text-[var(--text)]">Text</span>
            </a>
            <a href={site.emailHref} class="flex flex-col items-center gap-2 rounded-2xl border border-[var(--border)] bg-[var(--surface)] px-3 py-4 text-center transition-colors hover:border-[var(--color-brand)]">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-[var(--color-brand)]/10 text-[var(--color-brand)]"><Icon name="mail" size={18} /></span>
              <span class="text-sm font-semibold text-[var(--text)]">Email</span>
            </a>
          </div>
        </div>

        <!-- Reach us directly -->
        <div class="rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-7">
          <h2 class="font-display text-xl font-bold tracking-tight">Reach us directly</h2>
          <ul class="mt-5 space-y-4 text-sm">
            <li class="flex items-start gap-3">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[var(--color-brand)]/10 text-[var(--color-brand)]"><Icon name="phone" size={18} /></span>
              <span><span class="block text-[var(--text-subtle)]">Phone</span><a href={site.phoneHref} class="font-semibold text-[var(--text)] hover:text-[var(--color-brand)]">{site.phone}</a></span>
            </li>
            <li class="flex items-start gap-3">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[var(--color-brand)]/10 text-[var(--color-brand)]"><Icon name="mail" size={18} /></span>
              <span><span class="block text-[var(--text-subtle)]">Email</span><a href={site.emailHref} class="font-semibold text-[var(--text)] hover:text-[var(--color-brand)]">{site.email}</a></span>
            </li>
            <li class="flex items-start gap-3">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[var(--color-brand)]/10 text-[var(--color-brand)]"><Icon name="pin" size={18} /></span>
              <span><span class="block text-[var(--text-subtle)]">Office</span><span class="font-semibold text-[var(--text)]">{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postal}</span></span>
            </li>
            <li class="flex items-start gap-3">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[var(--color-brand)]/10 text-[var(--color-brand)]"><Icon name="clock" size={18} /></span>
              <span><span class="block text-[var(--text-subtle)]">Hours</span><span class="font-semibold text-[var(--text)]">{site.hours}</span></span>
            </li>
          </ul>
        </div>

        <!-- Map -->
        <div class="reveal overflow-hidden rounded-3xl border border-[var(--border)]" data-delay="180">
          <iframe
            title="Cozelos Data office location map"
            width="100%"
            height="260"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            style="border:0; display:block;"
            src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
          ></iframe>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
