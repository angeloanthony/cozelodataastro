---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Section from "../components/Section.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import AnimatedCounter from "../components/AnimatedCounter.astro";
import Testimonials from "../components/Testimonials.astro";
import FAQ from "../components/FAQ.astro";
import CTASection from "../components/CTASection.astro";
import MoveYourMouse from "../components/MoveYourMouse.astro";
import Button from "../components/Button.astro";
import { stats } from "../data/site";
---
<BaseLayout
  title="Web Design & SEO in Vernal, Utah — Custom Sites That Rank"
  description="Cozelos Data is a premium digital agency in Vernal, Utah. Custom websites, SEO, video, advertising, branding, and automation built to grow your business. Call (435) 219-5120."
>
  <Hero />

  <Marquee />

  <!-- Interactive statistics -->
  <Section class="!py-16">
    <div class="reveal grid grid-cols-2 gap-8 rounded-[var(--radius-xl2)] border border-[var(--border)] bg-[var(--surface-2)] p-10 sm:gap-12 lg:grid-cols-4">
      {stats.map((s) => (
        <AnimatedCounter value={s.value} suffix={s.suffix} label={s.label} class="reveal" />
      ))}
    </div>
  </Section>

  <!-- Services preview -->
  <Section
    eyebrow="What We Do"
    title="Six disciplines. One unified system."
    lead="We don't sell isolated deliverables — we build a digital system designed to compound. Every service connects to the next."
  >
    <ServicesGrid />
    <div class="mt-10 flex justify-center">
      <Button href="/services/" variant="secondary" size="lg" icon="arrow">Explore all services</Button>
    </div>
  </Section>

  <!-- Featured work — teaser cards that drive exploration of the Portfolio page -->
  <Section
    eyebrow="Featured Work"
    title="Real businesses. Real transformations."
    lead="A glimpse of the work. See the full case studies — stack, results, and live sites — in the portfolio."
  >
    <FeaturedProjects />
    <div class="mt-10 flex justify-center">
      <Button href="/portfolio/" variant="ghost" icon="arrow">See all projects</Button>
    </div>
  </Section>

  <!-- Wow factor -->
  <MoveYourMouse />

  <!-- Testimonials -->
  <Section
    eyebrow="Client Voices"
    title="They didn't just get a website."
    center
  >
    <Testimonials />
  </Section>

  <!-- FAQ -->
  <Section
    eyebrow="Common Questions"
    title="Everything you actually want to ask."
    lead="Pricing, timelines, ownership — straight answers before you ever get on a call."
    center
  >
    <FAQ limit={5} />
    <div class="mt-8 text-center">
      <Button href="/contact/" variant="ghost" icon="arrow">Still have a question? Ask us</Button>
    </div>
  </Section>

  <CTASection />
</BaseLayout>

<!--
  Home-page-only background tint. This <style> ships only on the home page, so
  overriding --surface here darkens the page background without touching other
  routes. Both themes are nudged a step darker than the global defaults.
-->
<style is:global>
  :root {
    --surface: #f1f5f9;
  }
  .dark {
    --surface: #06070b;
  }
</style>
