---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Section from "../components/Section.astro";
import ProblemNarrative from "../components/ProblemNarrative.astro";
import WhyDifferent from "../components/WhyDifferent.astro";
import MissionStatement from "../components/MissionStatement.astro";
import Philosophy from "../components/Philosophy.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import FounderTeaser from "../components/FounderTeaser.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import WhoWeWorkWith from "../components/WhoWeWorkWith.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import Results from "../components/Results.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import AnimatedCounter from "../components/AnimatedCounter.astro";
import Testimonials from "../components/Testimonials.astro";
import OurPromise from "../components/OurPromise.astro";
import FAQ from "../components/FAQ.astro";
import CTASection from "../components/CTASection.astro";
import Button from "../components/Button.astro";
import { stats, site, commercialFacts } from "../data/site";
---
<BaseLayout
  title="Web Design & SEO in Vernal, Utah — Custom Sites That Rank"
  description="Premium digital agency in Vernal, Utah. Custom websites, SEO, video, advertising, branding, and automation built to grow your business. Call (435) 219-5120."
>
  <Hero />

  <!-- Infinite scrolling band of industries we serve -->
  <Marquee />

  <!-- PROBLEM — the emotional opening -->
  <ProblemNarrative />

  <!-- WHY BUSINESSES STRUGGLE — typical agency vs. Cozelos -->
  <WhyDifferent />

  <!-- OUR PHILOSOPHY — mission + the core belief -->
  <MissionStatement />

  <Section class="!pt-4 !pb-16">
    <figure class="reveal mx-auto max-w-3xl text-center">
      <blockquote class="font-display text-3xl font-extrabold leading-[1.15] tracking-tight sm:text-4xl">
        Technology doesn&rsquo;t grow businesses. <span class="text-gradient">Strategy does.</span>
      </blockquote>
      <figcaption class="mt-5 text-lg text-[var(--text-muted)]">
        Technology simply makes great strategy scalable.
      </figcaption>
    </figure>
  </Section>

  <!-- OUR APPROACH — the four-layer philosophy + why us -->
  <Philosophy />
  <WhyChooseUs />

  <!-- PROOF — numbers + the leader behind the work -->
  <Section class="!py-16">
    <div class="reveal grid grid-cols-2 gap-8 rounded-[var(--radius-xl2)] border border-[var(--border)] bg-[var(--surface-2)] p-10 sm:gap-12 lg:grid-cols-4">
      {stats.map((s) => (
        <AnimatedCounter value={s.value} suffix={s.suffix} label={s.label} class="reveal" />
      ))}
    </div>
  </Section>

  <FounderTeaser />

  <!-- SERVICES -->
  <Section
    eyebrow="What We Do"
    title="Six disciplines. One growth system."
    lead="Six services, one connected system. Each one makes the others work harder — and your business grow faster."
  >
    <ServicesGrid />
    <div class="mt-10 flex justify-center">
      <Button href="/services/" variant="secondary" size="lg" icon="arrow">Explore all services</Button>
    </div>
  </Section>

  <!-- WHO WE WORK WITH -->
  <WhoWeWorkWith />

  <!-- PROCESS -->
  <ProcessSteps />

  <!-- RESULTS -->
  <Results />

  <!-- PROOF — featured work -->
  <Section
    eyebrow="Featured Work"
    title="Real businesses. Measurable growth."
    lead="Utah businesses we moved from invisible to in-demand. See the full stories in the portfolio."
  >
    <FeaturedProjects />
    <div class="mt-10 flex justify-center">
      <Button href="/portfolio/" variant="ghost" icon="arrow">See all projects</Button>
    </div>
  </Section>

  <!-- TESTIMONIALS -->
  <Section
    eyebrow="Client Voices"
    title="They didn't buy a website. They built an asset."
    center
  >
    <Testimonials />
    <div class="reveal mt-10 flex flex-col items-center gap-3">
      <p class="text-sm text-[var(--text-muted)]">Worked with us? Share your experience.</p>
      <Button href={site.googleReviewHref} variant="secondary" icon="star" external class="animate-attention">
        <span class="text-[var(--color-brand)]" aria-hidden="true">★★★★★</span>
        Leave a Google Review
      </Button>
    </div>
  </Section>

  <!-- TRUST — our promise -->
  <OurPromise />

  <!-- INVESTMENT -->
  <Section class="!py-16">
    <div class="reveal mx-auto max-w-3xl rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-8 text-center sm:p-12">
      <span class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--color-brand)]">The Investment</span>
      <h2 class="mt-4 font-display text-2xl font-extrabold tracking-tight sm:text-3xl">An investment in growth — priced for return.</h2>
      <p class="mx-auto mt-3 max-w-xl text-lg leading-relaxed text-[var(--text-muted)]">
        Custom projects start at {commercialFacts.websiteStartingPrice}, with monthly growth plans from {commercialFacts.maintenancePrice}.
        Every engagement begins with a strategy session — credited toward your build.
      </p>
      <div class="mt-7 flex justify-center">
        <Button href="/pricing/" size="lg" variant="secondary" icon="arrow">See Investment &amp; Plans</Button>
      </div>
    </div>
  </Section>

  <!-- FAQ -->
  <Section
    eyebrow="Common Questions"
    title="Everything you actually want to ask."
    lead="Pricing, timelines, ownership — straight answers before you ever get on a call."
    center
  >
    <FAQ />
    <div class="mt-8 text-center">
      <Button href="/faq/" variant="ghost" icon="arrow">Read all 25 FAQs</Button>
    </div>
  </Section>

  <!-- FINAL CTA -->
  <CTASection
    title="Let's build your growth platform."
    body="Tell us about your business. We'll show you exactly what we'd build — and the growth it's engineered to create."
    primaryLabel="Start Your Project"
    secondaryLabel="See the Work"
  />
</BaseLayout>

<!--
  Home-page-only background tint. This <style> ships only on the home page, so
  overriding --surface here darkens the page background without touching other
  routes. Both themes are nudged a step darker than the global defaults.
-->
<style is:global>
  :root {
    --surface: #f1f5f9;
  }
  .dark {
    --surface: #06070b;
  }
</style>
