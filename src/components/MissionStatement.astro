---
/**
 * MissionStatement — cinematic, centered brand mission for the home page.
 * Reframes a website as a compounding digital asset rather than an expense.
 *
 * Locale-aware (Step 27): props default to the English copy below so this
 * component is unaffected when no props are passed; HomePage.astro is the
 * only caller and supplies localized copy from home.json's `mission`.
 *
 * `tagline` is its own home.json field, NOT a read of shared.json's
 * `footer.tagline` — the two are similar but not identical strings ("Making
 * businesses stronger..." lowercase here vs. "Making Businesses Stronger..."
 * title case in the footer), so reusing the shared string would have quietly
 * changed this page's English casing. Unlike CompanyPage.astro's philosophy
 * panel (which really does render the footer's exact tagline), this one owns
 * its own copy.
 */
import SectionLabel from "./SectionLabel.astro";

interface Props {
  label?: string;
  headlineHtml?: string;
  tagline?: string;
  body?: string;
}
const {
  label = "Our Mission",
  headlineHtml = 'We don&rsquo;t simply build websites &mdash; we build <span class="text-gradient">digital assets that grow businesses.</span>',
  tagline = "Making businesses stronger. Making life better.",
  body = "A website is an expense. A growth platform is an investment — one that earns leads, authority, and revenue for years. We don’t build pages that sit online. We build systems that go to work for your business every day.",
} = Astro.props;
---
<section class="container-x py-24 sm:py-28">
  <div class="reveal mx-auto max-w-4xl text-center">
    <div class="flex justify-center">
      <SectionLabel>{label}</SectionLabel>
    </div>

    <p class="reveal mt-7 font-display text-3xl font-extrabold leading-[1.12] tracking-tight sm:text-4xl lg:text-5xl" data-delay="80" set:html={headlineHtml} />

    <p class="reveal mt-6 font-display text-lg font-semibold tracking-tight text-[var(--text-muted)] sm:text-xl" data-delay="140">
      {tagline}
    </p>

    <p class="reveal mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-[var(--text-muted)]" data-delay="200">
      {body}
    </p>
  </div>
</section>
