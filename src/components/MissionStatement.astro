---
/**
 * MissionStatement — cinematic, centered brand mission for the home page.
 * Reframes a website as a compounding digital asset rather than an expense.
 */
import SectionLabel from "./SectionLabel.astro";
---
<section class="container-x py-24 sm:py-28">
  <div class="reveal mx-auto max-w-4xl text-center">
    <div class="flex justify-center">
      <SectionLabel>Our Mission</SectionLabel>
    </div>

    <p class="reveal mt-7 font-display text-3xl font-extrabold leading-[1.12] tracking-tight sm:text-4xl lg:text-5xl" data-delay="80">
      We don&rsquo;t simply build websites &mdash; we build
      <span class="text-gradient">digital assets that grow businesses.</span>
    </p>

    <p class="reveal mt-6 font-display text-lg font-semibold tracking-tight text-[var(--text-muted)] sm:text-xl" data-delay="140">
      Making businesses stronger. Making life better.
    </p>

    <p class="reveal mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-[var(--text-muted)]" data-delay="200">
      A website is an expense. A growth platform is an investment — one that
      earns leads, authority, and revenue for years. We don&rsquo;t build pages
      that sit online. We build systems that go to work for your business every day.
    </p>
  </div>
</section>
