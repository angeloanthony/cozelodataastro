---
/**
 * AiSummary — a concise TL;DR block placed directly after a page's H1. This is
 * the text AI Overviews (Google, ChatGPT, Perplexity) tend to pull when citing
 * a page, so it leads with what the business is, its key advantage, and its
 * location, then closes with the phone number. SEO playbook Part 4 / Part 13.
 *
 * Pass the summary sentence(s) as the default slot, ending with a period; the
 * component appends the call-to-action with the business phone number.
 */
import { site } from "../data/site";
import { getLangFromUrl, t } from "../data/i18n";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// Chrome, not copy (playbook §2, domain 2): the same sentence closes this block
// on every page, so it comes from the dictionary and the locale from the URL.
//
// The sentence is SPLIT on its {phone} placeholder rather than interpolated,
// because the number has to render as a tel: link, not as text. Splitting keeps
// the translator in control of word order — a locale may open or close with the
// number — while the number itself stays data that is never retyped.
const lang = getLangFromUrl(Astro.url);
const [beforePhone, afterPhone = ""] = t("summary.quote", lang).split("{phone}");
---
<div
  class:list={[
    "reveal max-w-2xl rounded-2xl border border-[var(--border)] border-l-4 border-l-[var(--color-brand)] bg-[var(--surface-2)] p-5 text-[15px] leading-relaxed text-[var(--text-muted)]",
    className,
  ]}
  data-delay="160"
>
  <slot />{" "}
  <span class="whitespace-nowrap">{beforePhone}<a href={site.phoneHref} class="font-semibold text-[var(--color-brand)] link-underline">{site.phone}</a></span>{afterPhone}
</div>
