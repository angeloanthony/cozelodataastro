---
/**
 * MoveYourMouse — the "wow factor" section. Floating cards (genealogy records,
 * website mockups, marketing icons, data viz) drift with the cursor, and an
 * SVG draws animated connection lines between them. Pure CSS/JS, gracefully
 * static for reduced-motion / touch users.
 */
import Icon from "./Icon.astro";
---
<section class="container-x py-20">
  <div class="mb-10 text-center">
    <h2 class="font-display text-3xl font-extrabold tracking-tight sm:text-4xl">Move your mouse.</h2>
    <p class="mx-auto mt-3 max-w-xl text-[var(--text-muted)]">
      This whole section reacts to your cursor — a small demonstration of the
      kind of interactive detail we build into every project.
    </p>
  </div>

  <div
    data-pointer-stage
    class="reveal relative mx-auto h-[460px] max-w-4xl overflow-hidden rounded-[var(--radius-xl2)] border border-[var(--border)] bg-[var(--surface-2)]"
    style="--spot-x:50%;--spot-y:50%;"
  >
    <!-- Spotlight -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true"
      style="background: radial-gradient(360px circle at var(--spot-x) var(--spot-y), color-mix(in srgb, var(--color-brand) 12%, transparent), transparent 70%);"></div>
    <div class="bg-grid pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>

    <!-- Connection lines (animated dash) -->
    <svg class="pointer-events-none absolute inset-0 h-full w-full" viewBox="0 0 800 460" preserveAspectRatio="none" aria-hidden="true">
      <g stroke="var(--color-brand)" stroke-width="1.5" fill="none" opacity="0.35" stroke-dasharray="6 8">
        <path d="M160 120 L400 230">
          <animate attributeName="stroke-dashoffset" from="0" to="-28" dur="1.2s" repeatCount="indefinite" />
        </path>
        <path d="M640 110 L400 230">
          <animate attributeName="stroke-dashoffset" from="0" to="-28" dur="1.4s" repeatCount="indefinite" />
        </path>
        <path d="M180 350 L400 230">
          <animate attributeName="stroke-dashoffset" from="0" to="-28" dur="1.6s" repeatCount="indefinite" />
        </path>
        <path d="M620 360 L400 230">
          <animate attributeName="stroke-dashoffset" from="0" to="-28" dur="1.1s" repeatCount="indefinite" />
        </path>
      </g>
    </svg>

    <!-- Center hub -->
    <div data-float="10" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
      <div class="grid h-20 w-20 place-items-center rounded-2xl bg-[var(--color-brand)] text-white shadow-2xl shadow-[var(--color-brand)]/30">
        <span class="font-display text-xl font-extrabold">CD</span>
      </div>
    </div>

    <!-- Floating element: genealogy record -->
    <div data-float="40" class="glass absolute left-[12%] top-[20%] w-40 rounded-2xl p-4 shadow-xl">
      <div class="flex items-center gap-2 text-[var(--color-brand)]"><Icon name="doc" size={16} /><span class="text-xs font-bold text-[var(--text)]">Record</span></div>
      <div class="mt-3 space-y-1.5">
        <div class="h-2 w-full rounded-full bg-[var(--border-strong)]"></div>
        <div class="h-2 w-2/3 rounded-full bg-[var(--border-strong)]"></div>
      </div>
    </div>

    <!-- Floating element: website mockup -->
    <div data-float="55" class="glass absolute right-[12%] top-[16%] w-44 rounded-2xl p-3 shadow-xl">
      <div class="flex gap-1">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--border-strong)]"></span>
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--border-strong)]"></span>
      </div>
      <div class="mt-2 h-10 rounded-lg bg-gradient-to-br from-[var(--color-brand)]/40 to-orange-400/30"></div>
      <div class="mt-2 h-1.5 w-3/4 rounded-full bg-[var(--border-strong)]"></div>
    </div>

    <!-- Floating element: marketing icon -->
    <div data-float="48" class="glass absolute left-[16%] bottom-[18%] flex items-center gap-2 rounded-2xl px-4 py-3 shadow-xl">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-[var(--color-brand)]/15 text-[var(--color-brand)]"><Icon name="target" size={16} /></span>
      <div>
        <p class="text-xs font-bold text-[var(--text)]">+182%</p>
        <p class="text-[10px] text-[var(--text-subtle)]">Leads</p>
      </div>
    </div>

    <!-- Floating element: data viz -->
    <div data-float="62" class="glass absolute right-[15%] bottom-[16%] w-40 rounded-2xl p-4 shadow-xl">
      <div class="flex items-center gap-2 text-[var(--color-brand)]"><Icon name="search" size={16} /><span class="text-xs font-bold text-[var(--text)]">Traffic</span></div>
      <div class="mt-3 flex h-12 items-end gap-1.5">
        <span class="w-full rounded-t bg-[var(--color-brand)]/40" style="height:40%"></span>
        <span class="w-full rounded-t bg-[var(--color-brand)]/60" style="height:65%"></span>
        <span class="w-full rounded-t bg-[var(--color-brand)]/80" style="height:50%"></span>
        <span class="w-full rounded-t bg-[var(--color-brand)]" style="height:90%"></span>
      </div>
    </div>
  </div>
</section>
