---
/**
 * Seo — centralizes all <head> metadata: title, description, canonical,
 * Open Graph, Twitter cards, and JSON-LD structured data (LocalBusiness +
 * optional Service / Breadcrumb graphs).
 */
import { site } from "../data/site";
import { getLangFromUrl, getLocaleMeta } from "../data/i18n";
import { getShared } from "../i18n/shared";

interface Crumb { name: string; href: string; }

/**
 * A service the page actually describes. `path` should point at the section
 * that documents it, so the Service node has a real address on the site.
 */
interface ServiceRef { name: string; description?: string; path?: string; }

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  breadcrumbs?: Crumb[];
  services?: ServiceRef[];
  /** Set on utility pages (pay/terms/privacy) to keep them out of the index. */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = "/og-image.svg",
  type = "website",
  breadcrumbs,
  services,
  noindex = false,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const ogLocale = getLocaleMeta(lang).ogLocale;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
// Organization/ProfessionalService schema `description` (Step 29): locale-aware
// via shared.json, independent of whichever `description` this page passed in
// for its own <meta name="description">. English resolves to the same
// site.description text as before; Italian pages get a real translation
// instead of silently inheriting the English string.
const orgDescription = getShared(lang).schemaDescription;
// `slogan` was a hardcoded English literal (glossary-pinned) through Step 31;
// reversed afterward — now locale-aware via shared.json, same pattern as
// orgDescription above.
const slogan = getShared(lang).slogan;

// --- Structured data graph -------------------------------------------------
const graph: Record<string, unknown>[] = [
  {
    "@type": ["ProfessionalService", "Organization"],
    "@id": `${site.url}/#organization`,
    name: site.name,
    url: site.url,
    description: orgDescription,
    slogan,
    logo: new URL("/favicon.svg", site.url).href,
    image: ogImage,
    telephone: site.phone,
    email: site.email,
    priceRange: "$$",
    sameAs: site.sameAs,
    // Same @id as the Person node emitted on /ellen-cozelos/, so the founder is
    // ONE entity in the graph rather than an anonymous duplicate alongside it.
    founder: {
      "@type": "Person",
      "@id": `${site.url}/#ellen-cozelos`,
      name: site.founder,
      url: `${site.url}/ellen-cozelos/`,
    },
    address: {
      "@type": "PostalAddress",
      streetAddress: site.address.street,
      addressLocality: site.address.city,
      addressRegion: site.address.region,
      postalCode: site.address.postal,
      addressCountry: site.address.country,
    },
    geo: {
      "@type": "GeoCoordinates",
      latitude: site.geo.latitude,
      longitude: site.geo.longitude,
    },
    areaServed: [
      { "@type": "City", name: "Vernal" },
      { "@type": "AdministrativeArea", name: "Uintah Basin" },
      { "@type": "State", name: "Utah" },
      { "@type": "Country", name: "United States" },
    ],
    openingHoursSpecification: [
      {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        opens: "09:00",
        closes: "17:00",
      },
    ],
    identifier: [
      { "@type": "PropertyValue", name: "DUNS", value: site.credentials.duns },
      { "@type": "PropertyValue", name: "CAGE", value: site.credentials.cage },
    ],
  },
  {
    "@type": "WebSite",
    // Declares the language of the page context (playbook §8). Schema localizes
    // itself from the localized content; the language declaration is the piece
    // that has to be stated.
    inLanguage: lang,
    "@id": `${site.url}/#website`,
    url: site.url,
    name: site.name,
    publisher: { "@id": `${site.url}/#organization` },
  },
];

// Service nodes for the services a page actually documents. Each one references
// the single organization entity as its provider rather than declaring a new
// business, so the graph keeps exactly one LocalBusiness/Organization.
for (const s of services ?? []) {
  const serviceUrl = s.path ? new URL(s.path, site.url).href : undefined;
  graph.push({
    "@type": "Service",
    ...(serviceUrl && { "@id": serviceUrl, url: serviceUrl }),
    name: s.name,
    serviceType: s.name,
    ...(s.description && { description: s.description }),
    provider: { "@id": `${site.url}/#organization` },
    areaServed: { "@type": "State", name: "Utah" },
  });
}

if (breadcrumbs?.length) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.name,
      item: new URL(c.href, site.url).href,
    })),
  });
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={ogLocale} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
