---
/**
 * Timeline — a vertical story timeline with a progress line and reveal-on-scroll
 * entries. Used on the Company page.
 */
import { timeline } from "../data/site";
---
<ol class="relative mx-auto max-w-3xl">
  <!-- Spine -->
  <span class="absolute left-[15px] top-2 bottom-2 w-px bg-gradient-to-b from-[var(--color-brand)] via-[var(--border-strong)] to-transparent sm:left-1/2" aria-hidden="true"></span>

  {timeline.map((e, i) => (
    <li
      class:list={[
        "reveal relative mb-12 last:mb-0 sm:w-1/2",
        i % 2 === 0 ? "sm:pr-12" : "sm:ml-auto sm:pl-12 sm:text-left",
      ]}
      data-delay={i * 80}
    >
      <!-- Node -->
      <span
        class:list={[
          "absolute top-1.5 grid h-8 w-8 place-items-center rounded-full border-2 border-[var(--color-brand)] bg-[var(--surface)] text-xs font-bold text-[var(--color-brand)]",
          i % 2 === 0 ? "left-0 sm:left-auto sm:-right-4" : "left-0 sm:-left-4",
        ]}
      >{i + 1}</span>

      <div class:list={["ml-12 rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-6 sm:ml-0", i % 2 === 0 ? "" : ""]}>
        <span class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-brand)]">{e.year}</span>
        <h3 class="mt-2 font-display text-lg font-bold tracking-tight">{e.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{e.body}</p>
      </div>
    </li>
  ))}
</ol>
