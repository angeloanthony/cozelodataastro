---
/**
 * Icon — lightweight inline SVG set. Avoids shipping an icon font or library.
 * Stroke inherits currentColor so icons adopt their parent's text color.
 */
interface Props {
  name: string;
  class?: string;
  size?: number;
}
const { name, class: className = "", size = 24 } = Astro.props;

const paths: Record<string, string> = {
