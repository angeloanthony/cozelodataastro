---
/**
 * Credentials — government contracting block: capability badges plus a
 * color-coded NAICS code table.
 *
 * Presentation only. /company/ is this block's single consumer, so its prose
 * lives in that page's JSON and arrives as props — the Guarantees split.
 *
 * What deliberately does NOT arrive as props, and stays in src/data/site.ts:
 *   site.credentials.duns / .cage   business identifiers, and shared with the
 *                                   footer, which renders them on every page
 *   naicsTable                      NAICS codes AND their official titles are
 *                                   US federal classification identifiers, not
 *                                   prose (playbook §2, domain 3 — the same
 *                                   rule that keeps WOSB and Section 508 in
 *                                   English). A translator never retypes them.
 * Only the table's chrome — column headings, tier badges, caption — is copy.
 */
import { site, naicsTable } from "../data/site";
import Icon from "./Icon.astro";

interface Capability { icon: string; title: string; body: string }
interface Props {
  capabilities: Capability[];
  sourcesHtml: string;
  idLabels: { duns: string; cage: string; status: string };
  table: {
    caption: string;
    code: string;
    description: string;
    tier: string;
    primary: string;
    secondary: string;
  };
}
const { capabilities, sourcesHtml, idLabels, table } = Astro.props;
---
<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {capabilities.map((c, i) => (
    <div data-delay={i * 50} class="reveal flex gap-4 rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-5">
      <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[var(--color-brand)]/10 text-[var(--color-brand)]">
        <Icon name={c.icon} size={22} />
      </span>
      <div>
        <h3 class="font-display text-base font-bold tracking-tight">{c.title}</h3>
        <p class="mt-1 text-sm leading-relaxed text-[var(--text-muted)]">{c.body}</p>
      </div>
    </div>
  ))}
</div>

<!-- Sources for the two claims above that have a published standard behind them.
     A contracting officer reading this page can verify both without leaving to
     search for them. -->
<p class="reveal mt-6 text-sm leading-relaxed text-[var(--text-muted)]" set:html={sourcesHtml} />

<!-- Identifier strip -->
<div class="reveal mt-6 grid gap-3 sm:grid-cols-3">
  <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-5 text-center">
    <div class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--text-subtle)]">{idLabels.duns}</div>
    <div class="mt-1 font-mono text-xl font-bold text-[var(--text)]">{site.credentials.duns}</div>
  </div>
  <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-5 text-center">
    <div class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--text-subtle)]">{idLabels.cage}</div>
    <div class="mt-1 font-mono text-xl font-bold text-[var(--text)]">{site.credentials.cage}</div>
  </div>
  <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-5 text-center">
    <div class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--text-subtle)]">{idLabels.status}</div>
    <div class="mt-1 font-display text-xl font-bold text-[var(--color-brand)]">WOSB</div>
  </div>
</div>

<!-- NAICS table — overflow-x-auto lets the table scroll within its bordered box
     on narrow phones (≤360px) instead of clipping the Tier column. On desktop
     it fits, so no scrollbar appears and it renders identically. -->
<div class="reveal mt-6 overflow-x-auto rounded-2xl border border-[var(--border)]">
  <table class="w-full min-w-[22rem] text-left text-sm">
    <caption class="sr-only">{table.caption}</caption>
    <thead class="bg-[var(--surface-3)] text-xs font-bold uppercase tracking-[0.14em] text-[var(--text-subtle)]">
      <tr>
        <th scope="col" class="px-5 py-3.5">{table.code}</th>
        <th scope="col" class="px-5 py-3.5">{table.description}</th>
        <th scope="col" class="px-5 py-3.5 text-right">{table.tier}</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-[var(--border)] bg-[var(--surface-2)]">
      {naicsTable.map((row) => (
        <tr class="transition-colors hover:bg-[var(--surface-3)]">
          <td class="px-5 py-3.5 font-mono font-semibold text-[var(--text)]">{row.code}</td>
          <td class="px-5 py-3.5 text-[var(--text-muted)]">{row.desc}</td>
          <td class="px-5 py-3.5 text-right">
            {row.primary ? (
              <span class="inline-flex rounded-full bg-[var(--color-brand)] px-2.5 py-0.5 text-xs font-bold text-white">{table.primary}</span>
            ) : (
              <span class="inline-flex rounded-full bg-[var(--surface-3)] px-2.5 py-0.5 text-xs font-semibold text-[var(--text-subtle)]">{table.secondary}</span>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
