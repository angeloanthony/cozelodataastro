---
/**
 * Credentials — government contracting block: capability badges plus a
 * color-coded NAICS code table. Pulls all data from the site config.
 */
import { site, naicsTable } from "../data/site";
import Icon from "./Icon.astro";

const capabilities = [
  { icon: "award", title: "WOSB Eligible", body: "Woman-Owned Small Business — qualifies for set-aside and sole-source opportunities." },
  { icon: "building", title: "SAM Ready", body: "Active registration with a current UEI, ready for prime and sub-contracting awards." },
  { icon: "doc", title: "DUNS / UEI Active", body: "Universal Entity Identifier active and current for FAR-compliant contracting." },
  { icon: "shield", title: "Section 508", body: "Accessibility-conscious development aligned with WCAG 2.1 AA and Section 508." },
  { icon: "bolt", title: "Rapid Delivery", body: "Small enough to move fast, structured enough to hit milestones. Most sites in 4–6 weeks." },
  { icon: "lock", title: "Data Security", body: "Encrypted hosting, secure workflows, and clean handoff documentation every time." },
];
---
<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {capabilities.map((c, i) => (
    <div data-delay={i * 50} class="reveal flex gap-4 rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-5">
      <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[var(--color-brand)]/10 text-[var(--color-brand)]">
        <Icon name={c.icon} size={22} />
      </span>
      <div>
        <h3 class="font-display text-base font-bold tracking-tight">{c.title}</h3>
        <p class="mt-1 text-sm leading-relaxed text-[var(--text-muted)]">{c.body}</p>
      </div>
    </div>
  ))}
</div>

<!-- Identifier strip -->
<div class="reveal mt-6 grid gap-3 sm:grid-cols-3">
  <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-5 text-center">
    <div class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--text-subtle)]">DUNS</div>
    <div class="mt-1 font-mono text-xl font-bold text-[var(--text)]">{site.credentials.duns}</div>
  </div>
  <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-5 text-center">
    <div class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--text-subtle)]">CAGE Code</div>
    <div class="mt-1 font-mono text-xl font-bold text-[var(--text)]">{site.credentials.cage}</div>
  </div>
  <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-5 text-center">
    <div class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--text-subtle)]">Status</div>
    <div class="mt-1 font-display text-xl font-bold text-[var(--color-brand)]">WOSB</div>
  </div>
</div>

<!-- NAICS table — overflow-x-auto lets the table scroll within its bordered box
     on narrow phones (≤360px) instead of clipping the Tier column. On desktop
     it fits, so no scrollbar appears and it renders identically. -->
<div class="reveal mt-6 overflow-x-auto rounded-2xl border border-[var(--border)]">
  <table class="w-full min-w-[22rem] text-left text-sm">
    <caption class="sr-only">NAICS codes Cozelos Data contracts under</caption>
    <thead class="bg-[var(--surface-3)] text-xs font-bold uppercase tracking-[0.14em] text-[var(--text-subtle)]">
      <tr>
        <th scope="col" class="px-5 py-3.5">NAICS Code</th>
        <th scope="col" class="px-5 py-3.5">Description</th>
        <th scope="col" class="px-5 py-3.5 text-right">Tier</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-[var(--border)] bg-[var(--surface-2)]">
      {naicsTable.map((row) => (
        <tr class="transition-colors hover:bg-[var(--surface-3)]">
          <td class="px-5 py-3.5 font-mono font-semibold text-[var(--text)]">{row.code}</td>
          <td class="px-5 py-3.5 text-[var(--text-muted)]">{row.desc}</td>
          <td class="px-5 py-3.5 text-right">
            {row.primary ? (
              <span class="inline-flex rounded-full bg-[var(--color-brand)] px-2.5 py-0.5 text-xs font-bold text-white">PRIMARY</span>
            ) : (
              <span class="inline-flex rounded-full bg-[var(--surface-3)] px-2.5 py-0.5 text-xs font-semibold text-[var(--text-subtle)]">Secondary</span>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
