---
/**
 * ClientStrip — interim "logo bar": real client names linking to their live
 * sites, pulled straight from the portfolio data. More credible than an
 * industry list, and swaps cleanly for actual logos once those assets exist.
 */
import { projects } from "../data/site";

// Only clients with a live, linkable site.
const clients = projects.filter((p) => p.liveUrl);
---
<section class="border-y border-[var(--border)] bg-[var(--surface-2)] py-8" aria-label="Clients we've built for">
  <div class="container-x">
    <p class="reveal text-center text-xs font-bold uppercase tracking-[0.18em] text-[var(--text-subtle)]">
      Trusted by real businesses — live work you can visit
    </p>
    <ul class="reveal mt-5 flex flex-wrap items-center justify-center gap-x-7 gap-y-3 sm:gap-x-10" data-delay="80">
      {clients.map((c) => (
        <li>
          <a
            href={c.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline font-display text-base font-bold tracking-tight text-[var(--text-muted)] transition-colors hover:text-[var(--color-brand)] sm:text-lg"
          >
            {c.name}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
