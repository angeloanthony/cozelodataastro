---
/**
 * GoogleReviewButton — the animated "Leave a Google Review" pill used under the
 * homepage testimonials. Opens site.googleReviewHref (Google's write-a-review
 * dialog) in a new tab.
 *
 * Brand-red pill with a white circle holding the multi-colour Google "G", the
 * label, and five small stars that turn gold one after another on hover/focus.
 * A shine sweeps across it every few seconds, a soft brand-red halo pulses
 * around it, and a click throws a small burst of gold star sparks (the link
 * still navigates normally). All motion is off under prefers-reduced-motion;
 * the stars are hidden under ~420px so the pill fits on one line on phones.
 *
 * Every class is namespaced `cz-review-btn` and the styles are component-scoped.
 */
import { site } from "../data/site";

interface Props {
  label: string;
  ariaLabel: string;
  class?: string;
}
const { label, ariaLabel, class: className = "" } = Astro.props;
---
<a
  class:list={["cz-review-btn", className]}
  href={site.googleReviewHref}
  target="_blank"
  rel="noopener"
  aria-label={ariaLabel}
>
  <span class="cz-review-btn__g" aria-hidden="true">
    <svg viewBox="0 0 48 48" width="22" height="22"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
  </span>
  <span class="cz-review-btn__label">{label}</span>
  <span class="cz-review-btn__stars" aria-hidden="true">
    <i>★</i><i>★</i><i>★</i><i>★</i><i>★</i>
  </span>
</a>

<style>
  .cz-review-btn {
    --cz-gold: #fbbc05;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    max-width: 100%;
    padding: 0.6875rem 1.375rem 0.6875rem 0.75rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, var(--color-brand-700) 0%, var(--color-brand-500) 100%);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-decoration: none;
    box-shadow:
      0 8px 22px rgb(185 28 28 / 0.28),
      inset 0 1px 0 rgb(255 255 255 / 0.22);
    isolation: isolate;
    transition:
      transform 0.3s var(--ease-spring),
      box-shadow 0.3s var(--ease-spring);
  }
  /* Shine sweep, clipped to the pill by border-radius. */
  .cz-review-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: linear-gradient(110deg, transparent 30%, rgb(255 255 255 / 0.4) 50%, transparent 70%) no-repeat;
    background-size: 250% 100%;
    background-position: 150% 0;
    pointer-events: none;
  }
  /* Soft pulsing halo in the brand red (same family as .animate-attention). */
  .cz-review-btn::after {
    content: "";
    position: absolute;
    inset: -4px;
    z-index: -2;
    border-radius: inherit;
    border: 2px solid rgb(220 38 38 / 0.55);
    opacity: 0;
    pointer-events: none;
  }
  .cz-review-btn__g {
    display: grid;
    flex: 0 0 32px;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.2);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .cz-review-btn__label {
    min-width: 0;
  }
  .cz-review-btn__stars {
    display: inline-flex;
    gap: 1px;
    font-size: 0.95rem;
    letter-spacing: 0;
  }
  .cz-review-btn__stars i {
    font-style: normal;
    color: rgb(255 255 255 / 0.45);
    transition:
      color 0.2s ease,
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .cz-review-btn:hover,
  .cz-review-btn:focus-visible {
    transform: translateY(-2px);
    box-shadow:
      0 12px 28px rgb(185 28 28 / 0.38),
      inset 0 1px 0 rgb(255 255 255 / 0.22);
  }
  .cz-review-btn:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 3px;
  }
  .cz-review-btn:active {
    transform: translateY(0) scale(0.97);
  }
  .cz-review-btn:hover .cz-review-btn__g,
  .cz-review-btn:focus-visible .cz-review-btn__g {
    transform: rotate(-12deg) scale(1.1);
  }

  /* Stars turn gold one after another on hover/focus. */
  .cz-review-btn:hover .cz-review-btn__stars i,
  .cz-review-btn:focus-visible .cz-review-btn__stars i {
    color: var(--cz-gold);
    transform: scale(1.25);
  }
  .cz-review-btn__stars i:nth-child(2) { transition-delay: 0.06s; }
  .cz-review-btn__stars i:nth-child(3) { transition-delay: 0.12s; }
  .cz-review-btn__stars i:nth-child(4) { transition-delay: 0.18s; }
  .cz-review-btn__stars i:nth-child(5) { transition-delay: 0.24s; }

  /* Click sparks are created by the script below, so they carry no scoped
     attribute — reach them with :global(), still namespaced under the pill. */
  .cz-review-btn :global(.cz-review-btn__spark) {
    position: absolute;
    top: 50%;
    left: 50%;
    color: var(--cz-gold);
    font-size: 14px;
    line-height: 1;
    pointer-events: none;
    text-shadow: 0 0 6px rgb(251 188 5 / 0.6);
    animation: cz-review-spark 0.7s ease-out forwards;
  }
  @keyframes cz-review-spark {
    from {
      transform: translate(-50%, -50%) scale(0.6);
      opacity: 1;
    }
    to {
      transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(1.1) rotate(180deg);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .cz-review-btn::before { animation: cz-review-shine 4s ease-in-out 1.5s infinite; }
    .cz-review-btn::after { animation: cz-review-halo 2.8s ease-out infinite; }
    .cz-review-btn:hover::before { animation-duration: 1.2s; animation-delay: 0s; }
  }
  @keyframes cz-review-shine {
    0%, 60% { background-position: 150% 0; }
    100% { background-position: -50% 0; }
  }
  @keyframes cz-review-halo {
    0% { transform: scale(0.96); opacity: 0.8; }
    100% { transform: scale(1.12); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cz-review-btn,
    .cz-review-btn__g,
    .cz-review-btn__stars i { transition: none; }
    .cz-review-btn:hover,
    .cz-review-btn:focus-visible,
    .cz-review-btn:active,
    .cz-review-btn:hover .cz-review-btn__g,
    .cz-review-btn:focus-visible .cz-review-btn__g,
    .cz-review-btn:hover .cz-review-btn__stars i,
    .cz-review-btn:focus-visible .cz-review-btn__stars i { transform: none; }
  }
  @media (max-width: 420px) {
    .cz-review-btn {
      gap: 0.5rem;
      padding: 0.625rem 0.875rem 0.625rem 0.625rem;
      font-size: 0.92rem;
    }
    .cz-review-btn__stars { display: none; }
  }
</style>

<script>
  // Click burst of gold stars. Delegated from document so it binds once and
  // keeps working across ClientRouter navigations. The link still opens
  // normally; nothing here calls preventDefault().
  document.addEventListener("click", (e) => {
    const btn = (e.target as Element | null)?.closest?.(".cz-review-btn");
    if (!btn) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    for (let i = 0; i < 10; i++) {
      const s = document.createElement("span");
      s.className = "cz-review-btn__spark";
      s.setAttribute("aria-hidden", "true");
      s.textContent = "★";
      const angle = (Math.PI * 2 * i) / 10 + Math.random() * 0.4;
      const dist = 40 + Math.random() * 30;
      s.style.setProperty("--dx", `${Math.cos(angle) * dist}px`);
      s.style.setProperty("--dy", `${Math.sin(angle) * dist}px`);
      btn.appendChild(s);
      s.addEventListener("animationend", () => s.remove());
      setTimeout(() => s.remove(), 1000); // fallback if animations are paused
    }
  });
</script>
