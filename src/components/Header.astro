---
/**
 * Header — sticky glass navigation with:
 *  - active link highlighting
 *  - animated underlines
 *  - responsive mobile menu (no JS framework needed)
 *  - persistent dark mode toggle
 *  - a thin scroll-progress indicator 
 */
import { Image } from "astro:assets";
import logoImg from "../assets/cozeloslogo.webp";

import { site, primaryNav } from "../data/site";
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import { getLangFromUrl, t } from "../data/i18n";
import { localizeHref } from "../i18n/content";

// Locale comes from the URL, not from props (playbook §10). Every internal
// chrome href is routed through localizeHref, which is existence-aware: it
// returns /it/<slug>/ only when that translation is committed, and the master
// URL otherwise. Nothing here knows *which* pages are translated.
const lang = getLangFromUrl(Astro.url);

// Nav labels come from the chrome dictionary (playbook §2, domain 2), keyed by
// the item's master href — site.ts stays the single source of *structure*, the
// dictionary the single source of *wording*. An href with no key keeps the
// site.ts label, so adding a nav item can never crash the header.
const NAV_KEY: Record<string, Parameters<typeof t>[0]> = {
  "/": "nav.home",
  "/services/": "nav.services",
  "/why-cozelos-data/": "nav.why",
  "/pricing/": "nav.pricing",
  "/portfolio/": "nav.portfolio",
  "/company/": "nav.company",
  "/contact/": "nav.contact",
};
const nav = primaryNav.map((item) => ({
  ...item,
  label: NAV_KEY[item.href] ? t(NAV_KEY[item.href], lang) : item.label,
  href: localizeHref(item.href, lang),
}));
const homeHref = localizeHref("/", lang);
const contactHref = localizeHref("/contact/", lang);

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

---
<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
  transition:persist={`site-header-${lang}`}
>
  <!-- Scroll progress bar -->
  <div
    id="scroll-progress"
    class="absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0 bg-[var(--color-brand)]"
    aria-hidden="true"
  ></div>

  <nav class="container-x" aria-label={t("a11y.primaryNav", lang)}>
    <div
      class="mt-3 flex items-center justify-between rounded-2xl border border-[var(--glass-border)] px-4 py-2.5 transition-all duration-300 [.is-scrolled_&]:shadow-lg [.is-scrolled_&]:shadow-black/5 glass"
    >
      <!-- Logo -->
      <a href={homeHref} class="group flex items-center gap-3" aria-label={t("a11y.home", lang, { brand: site.name })}>
  <Image
  src={logoImg}
  alt="Cozelos Data"
  width={200}
  class="site-logo h-12 w-auto"
 />

  <span class="site-wordmark whitespace-nowrap font-display text-3xl font-extrabold tracking-tight text-red-600">
  COZELOS DATA
</span>
</a>

      <!-- Desktop nav -->
      <ul class="hidden items-center gap-1 lg:flex">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              data-nav-link
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "link-underline rounded-lg px-3 py-2 text-sm font-medium transition-colors duration-200",
                isActive(item.href)
                  ? "text-[var(--color-brand)]"
                  : "text-[var(--text-muted)] hover:text-[var(--text)]",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-2">
        <!-- Dark mode toggle -->
        <button
          id="theme-toggle"
          type="button"
          class="grid h-9 w-9 place-items-center rounded-xl border border-[var(--border)] text-[var(--text-muted)] transition-colors duration-200 hover:text-[var(--color-brand)]"
          aria-label={t("a11y.theme", lang)}
        >
          <Icon name="sun" size={18} class="hidden dark:block" />
          <Icon name="moon" size={18} class="block dark:hidden" />
        </button>

        <div class="hidden lg:block">
          <Button href={contactHref} size="md" magnetic icon="arrow">{t("cta.quote", lang)}</Button>
        </div>

        <!-- Mobile menu button -->
        <button
          id="menu-open"
          type="button"
          class="grid h-9 w-9 place-items-center rounded-xl border border-[var(--border)] text-[var(--text)] lg:hidden"
          aria-label={t("a11y.menuOpen", lang)}
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="menu" size={20} />
        </button>
      </div>
    </div>
  </nav>
</header>

<style>
  /*
    Mobile header (≤480px). Desktop is untouched.

    The logo mark stays 48px so the header height keeps matching --header-h
    (which is derived from that 48px logo). To stop "COZELOS DATA" from wrapping
    to two lines beside it, the wordmark gets `whitespace-nowrap` (in markup)
    plus a fluid clamp() that shrinks it just enough to sit on one line next to
    the logo across the whole phone range. The slope (≈13.9vw − 2.25rem) is
    derived from the measured single-line width vs. the space left beside the
    48px logo + the right-hand controls, so it never overflows and meets the
    desktop 30px size again at ~475px (a seamless handoff to the default).
  */
  @media (max-width: 480px) {
    .site-wordmark {
      /* Slope derived from the measured single-line width vs. available space,
         then backed off ~8px so there's a real gap before the controls. */
      font-size: clamp(0.8125rem, 13.9vw - 2.3rem, 1.875rem);
      letter-spacing: -0.03em; /* a hair tighter to buy a little width */
    }
  }

  /* Below ~360px there isn't enough room for a legible one-line wordmark next
     to the logo, so show the logo mark alone — the cleanest premium fallback
     rather than a cramped or wrapped wordmark. The header height is unaffected
     because the 48px logo still sets it. */
  @media (max-width: 359px) {
    .site-wordmark { display: none; }
  }
</style>

<!-- Mobile menu overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] translate-x-full transition-transform duration-400 ease-[var(--ease-spring)] lg:hidden"
  aria-hidden="true"
>
  <div class="absolute inset-0 bg-[var(--surface)]"></div>
  <div class="relative flex h-full flex-col p-6">
    <div class="flex items-center justify-between">
      <span class="font-display text-lg font-extrabold">{t("nav.menu", lang)}</span>
      <button
        id="menu-close"
        type="button"
        class="grid h-10 w-10 place-items-center rounded-xl border border-[var(--border)]"
        aria-label={t("a11y.menuClose", lang)}
      >
        <Icon name="close" size={22} />
      </button>
    </div>

    <ul class="mt-10 flex flex-col gap-1">
      {nav.map((item, i) => (
        <li>
          <a
            href={item.href}
            class="flex items-center justify-between rounded-2xl px-4 py-4 font-display text-2xl font-bold text-[var(--text)] transition-colors hover:bg-[var(--surface-3)] hover:text-[var(--color-brand)]"
            style={`transition-delay:${i * 40}ms`}
          >
            {item.label}
            <Icon name="arrow" size={22} class="text-[var(--text-subtle)]" />
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-auto space-y-4">
      <Button href={contactHref} size="lg" icon="arrow" class="w-full">{t("cta.quote", lang)}</Button>
      <div class="flex flex-col gap-1 text-sm text-[var(--text-muted)]">
        <a href={site.phoneHref} class="font-semibold text-[var(--text)]">{site.phone}</a>
        <a href={site.emailHref}>{site.email}</a>
      </div>
    </div>
  </div>
</div>

<script>
  // Mobile menu + dark mode wiring.
  //
  // The header is transition:persist'd (so #menu-open / #theme-toggle survive
  // navigations) but the #mobile-menu overlay is NOT — Astro swaps in a fresh
  // menu node on every navigation. So we re-query and re-bind on each
  // astro:page-load. We use idempotent `.onclick` assignment (not
  // addEventListener) so the *persisted* buttons never accumulate duplicate
  // handlers across navigations, while the freshly-rendered menu always gets
  // wired to its live DOM node.
  //
  // The one listener that genuinely needs to bind only once is the document
  // keydown handler (document is never replaced). It calls through a
  // module-scoped reference that wireHeader refreshes each load, so Escape
  // always closes the *current* menu rather than a stale, detached one.
  let currentSetMenu: ((show: boolean) => void) | null = null;
  let escWired = false;

  function wireHeader() {
    const menu = document.getElementById("mobile-menu");
    const open = document.getElementById("menu-open");
    const close = document.getElementById("menu-close");

    const setMenu = (show: boolean) => {
      if (!menu) return;
      menu.classList.toggle("translate-x-full", !show);
      menu.setAttribute("aria-hidden", String(!show));
      // Keep off-screen links out of the tab order + AT tree when closed.
      if (show) menu.removeAttribute("inert");
      else menu.setAttribute("inert", "");
      open?.setAttribute("aria-expanded", String(show));
      document.body.style.overflow = show ? "hidden" : "";
      // Move focus into the menu on open, return it to the trigger on close.
      if (show) close?.focus();
      else open?.focus();
    };
    currentSetMenu = setMenu;

    menu?.setAttribute("inert", ""); // closed by default on every (re)render

    if (open) open.onclick = () => setMenu(true);
    if (close) close.onclick = () => setMenu(false);
    menu?.querySelectorAll<HTMLAnchorElement>("a").forEach((a) => {
      a.onclick = () => setMenu(false);
    });

    if (!escWired) {
      escWired = true;
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") currentSetMenu?.(false);
      });
    }

    const toggle = document.getElementById("theme-toggle");
    if (toggle)
      toggle.onclick = () => {
        const isDark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("theme", isDark ? "dark" : "light");
        } catch {}
      };
  }

  // The header is transition:persist'd, so its server-rendered active highlight
  // is frozen from whatever page first rendered it. Recompute it on every
  // navigation so the correct nav item is highlighted for the current page.
  function updateActiveNav() {
    const path = window.location.pathname;
    const isActive = (href: string) =>
      href === "/" ? path === "/" : path.startsWith(href);
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]").forEach((a) => {
      const active = isActive(a.getAttribute("href") || "");
      a.classList.toggle("text-[var(--color-brand)]", active);
      a.classList.toggle("text-[var(--text-muted)]", !active);
      a.classList.toggle("hover:text-[var(--text)]", !active);
      if (active) a.setAttribute("aria-current", "page");
      else a.removeAttribute("aria-current");
    });
  }

  document.addEventListener("astro:page-load", () => {
    wireHeader();
    updateActiveNav();
  });
</script>
