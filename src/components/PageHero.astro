---
/**
 * PageHero — compact hero used at the top of interior pages. Renders an
 * eyebrow, title, lead paragraph, and a breadcrumb trail.
 */
import SectionLabel from "./SectionLabel.astro";
import Icon from "./Icon.astro";

interface Crumb { name: string; href: string; }
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  breadcrumbs?: Crumb[];
}
const { eyebrow, title, lead, breadcrumbs = [] } = Astro.props;
---
<section class="relative overflow-hidden pt-36 pb-14 sm:pt-44 sm:pb-20">
  <div class="bg-grid pointer-events-none absolute inset-0 -z-10 opacity-50" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -left-20 top-24 -z-10 h-64 w-64 bg-[var(--color-brand)]/10 blur-3xl" style="animation: blob 20s ease-in-out infinite;" aria-hidden="true"></div>

  <div class="container-x">
    {breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="reveal mb-5">
        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-[var(--text-subtle)]">
          {breadcrumbs.map((c, i) => (
            <li class="flex items-center gap-1.5">
              {i > 0 && <Icon name="arrow" size={14} class="text-[var(--text-subtle)]" />}
              {i < breadcrumbs.length - 1 ? (
                <a href={c.href} class="link-underline hover:text-[var(--text)]">{c.name}</a>
              ) : (
                <span class="font-medium text-[var(--text)]" aria-current="page">{c.name}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div
      class:list={[
        "grid items-center gap-10 lg:gap-14",
        Astro.slots.has("default") && "lg:grid-cols-2",
      ]}
    >
      <div>
        <div class="reveal" data-delay="60">
          <SectionLabel>{eyebrow}</SectionLabel>
        </div>
        <h1 class="reveal mt-5 max-w-3xl font-display text-4xl font-extrabold leading-[1.08] tracking-tight sm:text-5xl" data-delay="120">
          {title}
        </h1>
        {lead && (
          <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-[var(--text-muted)]" data-delay="180">{lead}</p>
        )}
      </div>

      {Astro.slots.has("default") && (
        <div class="reveal w-full lg:justify-self-end" data-delay="240">
          <slot />
        </div>
      )}
    </div>
  </div>
</section>
