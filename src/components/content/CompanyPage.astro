---
/**
 * CompanyPage — THE template for /company/ (playbook §6.5).
 *
 * One shared component implements the page; the master route (/company/) and
 * the dynamic localized route (/it/company/) both render it. All page copy
 * comes from src/i18n/content/<locale>/company.json.
 *
 * Ownership decisions made during the Step 17 audit, recorded here because they
 * are the non-obvious part:
 *   timeline    was `timeline` in src/data/site.ts, imported only by
 *               Timeline.astro, which only /company/ renders. Single-consumer
 *               prose, so it moved into this page's JSON.
 *   credentials Credentials.astro is likewise single-consumer, so its capability
 *               and table copy moved here — but site.credentials (DUNS, CAGE)
 *               is ALSO rendered by the footer on every page, and naicsTable
 *               holds official US classification titles. Both stay in site.ts
 *               as data and are interpolated by the component.
 *   tagline     "Making Businesses Stronger. Making Life Better." already lives
 *               in shared.json as footer.tagline and renders in the footer of
 *               every page. It is read from there, never copied into
 *               company.json, so the two can never drift.
 *   CTA         the closing band's secondary label is exactly the shared
 *               default (cta.work), so it is not passed at all and resolves
 *               from shared content. Only the page-specific primary label is
 *               page copy. Same for the government block's "Schedule a Call",
 *               which is shared cta.call.
 */
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../PageHero.astro";
import Section from "../Section.astro";
import Timeline from "../Timeline.astro";
import Credentials from "../Credentials.astro";
import CTASection from "../CTASection.astro";
import Button from "../Button.astro";
import Icon from "../Icon.astro";
import { site, commercialFacts } from "../../data/site";
import { getImage } from "../../lib/images";
import { getLangFromUrl } from "../../data/i18n";
import { getPageContent, localizeHref, interp } from "../../i18n/content";
import { getShared } from "../../i18n/shared";

const lang = getLangFromUrl(Astro.url);
const c = getPageContent<any>("company", lang);
const shared = getShared(lang);

const breadcrumbs = [
  { name: "Home", href: localizeHref("/", lang) },
  { name: c.breadcrumb, href: localizeHref("/company/", lang) },
];

const officeImg = getImage("CozeloOffice.webp");

// The brand tagline is one shared string; the philosophy panel has always set
// it on two lines. Split on the sentence boundary rather than storing a second,
// pre-broken copy of a string the footer also renders.
const taglineLines = shared.footer.tagline.split(/(?<=\.)\s+/);
---
<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow={c.hero.eyebrow}
    title={c.hero.title}
    lead={c.hero.lead}
    summary={c.hero.summary}
    breadcrumbs={breadcrumbs}
  />

  <!-- Founder story -->
  <Section eyebrow={c.founder.eyebrow} title={c.founder.title}>
    <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
      <!-- Narrative -->
      <div class="reveal space-y-4 text-lg leading-relaxed text-[var(--text-muted)] lg:col-span-7">
        {c.founder.paragraphsHtml.map((p: string) => <p set:html={p} />)}
        <p class="border-l-2 border-[var(--color-brand)] pl-5 font-display text-xl font-semibold text-[var(--text)]">
          {c.founder.pullQuote}
        </p>
        <div class="mt-7">
          <Button href={localizeHref("/ellen-cozelos/", lang)} variant="secondary" icon="arrow">{c.founder.bioCta}</Button>
        </div>
      </div>

      <!-- Founder card -->
      <div class="reveal lg:col-span-5" data-delay="120">
        <div class="rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-7">
          <div class="flex items-center gap-4">
            <span class="grid h-16 w-16 place-items-center rounded-2xl bg-[var(--color-brand)] font-display text-xl font-extrabold text-white">{c.founder.card.initials}</span>
            <div>
              <p class="font-display text-lg font-bold tracking-tight">{c.founder.card.name}</p>
              <p class="text-sm text-[var(--text-muted)]">{c.founder.card.role}</p>
            </div>
          </div>
          <ul class="mt-6 space-y-3">
            {c.founder.card.creds.map((cred: { icon: string; label: string }) => (
              <li class="flex items-center gap-3 text-sm text-[var(--text-muted)]">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-[var(--color-brand)]/10 text-[var(--color-brand)]"><Icon name={cred.icon} size={18} /></span>
                {cred.label}
              </li>
            ))}
          </ul>
          {officeImg && (
            <div class="mt-6 overflow-hidden rounded-2xl border border-[var(--border)]">
              <Image
                src={officeImg}
                alt={c.founder.card.imageAlt}
                widths={[400, 700]}
                sizes="(min-width: 1024px) 38vw, 92vw"
                loading="lazy"
                decoding="async"
                format="webp"
                class="w-full object-cover"
              />
            </div>
          )}
          <div class="mt-5 flex items-center gap-3 rounded-2xl bg-[var(--surface-3)] p-4">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-[var(--color-brand)] text-white"><Icon name="pin" size={18} /></span>
            <div class="text-sm">
              <p class="font-semibold text-[var(--text)]">{c.founder.card.locationTitle}</p>
              <p class="text-[var(--text-subtle)]">{c.founder.card.locationBody}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Mission & Vision -->
  <Section eyebrow={c.mission.eyebrow} title={c.mission.title}>
    <div class="grid gap-6 lg:grid-cols-2">
      {c.mission.cards.map((card: { icon: string; title: string; body: string }, i: number) => (
        <div class="reveal rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-8" data-delay={i === 0 ? undefined : 120}>
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-[var(--color-brand)]/10 text-[var(--color-brand)]"><Icon name={card.icon} size={24} /></span>
          <h3 class="mt-5 font-display text-xl font-bold tracking-tight">{card.title}</h3>
          <p class="mt-3 leading-relaxed text-[var(--text-muted)]">{card.body}</p>
        </div>
      ))}
    </div>

    <p class="reveal mx-auto mt-10 max-w-2xl text-center leading-relaxed text-[var(--text-muted)]" set:html={c.mission.noteHtml} />
  </Section>

  <!-- Philosophy -->
  <Section class="!pb-10">
    <div class="reveal mx-auto max-w-3xl rounded-3xl border border-[var(--color-brand)]/30 bg-[var(--surface-2)] p-10 text-center sm:p-14">
      <span class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--color-brand)]">{c.philosophy.eyebrow}</span>
      <p class="mt-4 font-display text-3xl font-extrabold leading-[1.15] tracking-tight sm:text-4xl">
        {taglineLines.map((line: string, i: number) => (
          <Fragment>{i > 0 && <br />}{line}</Fragment>
        ))}
      </p>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-[var(--text-muted)]">
        {c.philosophy.body}
      </p>
    </div>
  </Section>

  <!-- Community -->
  <Section eyebrow={c.community.eyebrow} title={c.community.title}>
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div class="reveal space-y-4 text-lg leading-relaxed text-[var(--text-muted)]">
        {c.community.paragraphs.map((p: string) => <p>{p}</p>)}
      </div>
      <div class="reveal" data-delay="120">
        <div class="grid gap-4 sm:grid-cols-2">
          {c.community.cards.map((card: { icon: string; title: string; body: string }) => (
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-5">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-[var(--color-brand)]/10 text-[var(--color-brand)]"><Icon name={card.icon} size={20} /></span>
              <h3 class="mt-3 font-display text-base font-bold tracking-tight">{card.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-[var(--text-muted)]">{card.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Section>

  <!-- Woman-Owned Small Business / Government -->
  <Section
    id="government"
    eyebrow={c.government.eyebrow}
    title={c.government.title}
    lead={c.government.lead}
  >
    <Credentials
      capabilities={c.government.credentials.capabilities.map((cap: any) => ({
        ...cap,
        // Only "Rapid Delivery" carries a {websiteTimelineWeeks} token (Step
        // 20); interp() is a no-op on every other capability's body.
        body: interp(cap.body, commercialFacts),
      }))}
      sourcesHtml={c.government.credentials.sourcesHtml}
      idLabels={c.government.credentials.idLabels}
      table={c.government.credentials.table}
    />

    <div class="reveal mt-8 grid gap-6 rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-8 lg:grid-cols-2 lg:items-center">
      <div>
        <h3 class="font-display text-xl font-bold tracking-tight">{c.government.statement.title}</h3>
        <p class="mt-2 text-[var(--text-muted)]">{c.government.statement.body}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
        <Button href={site.emailHref} icon="mail">{c.government.statement.requestCta}</Button>
        <Button href={localizeHref("/contact/", lang)} variant="secondary">{shared.cta.call}</Button>
      </div>
    </div>
  </Section>

  <!-- Commitment to clients -->
  <Section eyebrow={c.commitment.eyebrow} title={c.commitment.title}>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {c.commitment.cards.map((card: { icon: string; title: string; body: string }, i: number) => (
        <div data-delay={i * 50} class="reveal rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-7 transition-colors hover:border-[var(--color-brand)]/40">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-[var(--color-brand)]/10 text-[var(--color-brand)]"><Icon name={card.icon} size={22} /></span>
          <h3 class="mt-5 font-display text-lg font-bold tracking-tight">{card.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{card.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Timeline -->
  <Section eyebrow={c.timeline.eyebrow} title={c.timeline.title} center>
    <Timeline events={c.timeline.events} />
  </Section>

  <CTASection
    title={c.cta.title}
    body={c.cta.body}
    primaryLabel={c.cta.primaryLabel}
  />
</BaseLayout>
