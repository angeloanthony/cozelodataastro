---
/**
 * PortfolioPage — THE template for /portfolio/ (playbook §6.5, Step 25 of the
 * FAQ/i18n effort). One shared component implements the page; the master
 * route (/portfolio/) and the dynamic localized route (/it/portfolio/) both
 * render it.
 *
 * Three-tier content, the same separation Step 24 (Services) established:
 *   site.ts             -> project identity/structure (slug, name, accent,
 *                           image, liveUrl, featured, stack) — never translated
 *   shared.json          -> category + tagline + summary + results, via
 *                           getProjects() — multi-consumer (ProjectCard.astro,
 *                           rendered both by PortfolioGrid below AND by
 *                           FeaturedProjects.astro on the homepage), joined on
 *                           slug
 *   portfolio.json        -> single-consumer page body copy (hero, before/
 *                            after slider, section labels, stats labels, CTA,
 *                            and the per-project overview/challenge/strategy/
 *                            solution/outcome/businessImpact case-study prose)
 *
 * `stack` (technology/feature badges) is left untranslated in site.ts, same as
 * `slug`/`name`/`accent`/`image`/`liveUrl` — Step 25 deliberately did not
 * invent Italian labels for terms like "JSON-LD Schema" or "llms.txt" (playbook
 * caution against blindly translating technology identifiers).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../PageHero.astro";
import Section from "../Section.astro";
import PortfolioGrid from "../PortfolioGrid.astro";
import AnimatedCounter from "../AnimatedCounter.astro";
import CTASection from "../CTASection.astro";
import Icon from "../Icon.astro";
import { Image } from "astro:assets";
import { getImage } from "../../lib/images";
import afterImage from "../../assets/portfolio/forebearfind.webp";
import { getLangFromUrl, t as tChrome } from "../../data/i18n";
import { getPageContent, localizeHref, interp } from "../../i18n/content";
import { getProjects } from "../../i18n/shared";
import { commercialFacts } from "../../data/site";

const lang = getLangFromUrl(Astro.url);
const c = getPageContent<any>("portfolio", lang);
const projects = getProjects(lang);

const breadcrumbs = [
  { name: "Home", href: localizeHref("/", lang) },
  { name: c.breadcrumb, href: localizeHref("/portfolio/", lang) },
];

/** Resolve the {token} commercial-fact placeholders (Step 20). */
const t = (s: string) => interp(s, commercialFacts);
---
<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow={c.hero.eyebrow}
    title={c.hero.title}
    lead={c.hero.lead}
    summary={c.hero.summary}
    breadcrumbs={breadcrumbs}
  />

  <!-- Orientation: what produced this work, and what it costs -->
  <Section class="!pt-12 !pb-0">
    <p class="reveal mx-auto max-w-3xl text-center text-lg leading-relaxed text-[var(--text-muted)]" set:html={t(c.orientationHtml)} />
  </Section>

  <!-- Before / After slider -->
<Section
  eyebrow={c.compareSection.eyebrow}
  title={c.compareSection.title}
  lead={c.compareSection.lead}
  center
>
  <div
    id="ba-slider"
    class="reveal relative mx-auto aspect-[16/9] max-w-3xl cursor-ew-resize select-none overflow-hidden rounded-3xl border border-[var(--border)]"
  >
    <!-- After (right side - your image) -->
    <div
      class="absolute inset-0 bg-cover bg-center"
      style={`background-image: url(${afterImage.src});`}
    >
      <div class="absolute inset-0 bg-gradient-to-br from-black/40 via-black/50 to-black/70"></div>
      <div class="relative h-full grid place-items-center text-center text-white">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-white/70">{c.compareAfter.badge}</p>
          <p class="mt-2 font-display text-3xl font-extrabold">{c.compareAfter.headline}</p>
          <p class="mt-1 text-white/70">{c.compareAfter.sub}</p>
        </div>
      </div>
    </div>

    <!-- Before (left side) -->
    <div
      id="ba-before"
      class="absolute inset-0 bg-cover bg-center bg-[var(--surface-3)]"
      style="clip-path: inset(0 50% 0 0);"
    >
      <div class="absolute inset-0 bg-gradient-to-br from-black/40 via-black/50 to-black/70"></div>
      <div class="relative h-full grid place-items-center text-center text-white">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em]">{c.compareBefore.badge}</p>
          <p class="mt-2 font-display text-3xl font-extrabold">{c.compareBefore.headline}</p>
          <p class="mt-1">{c.compareBefore.sub}</p>
        </div>
      </div>
    </div>

    <!-- Handle -->
    <div id="ba-handle" class="absolute inset-y-0 z-10 w-1 -translate-x-1/2 bg-white" style="left:50%;">
      <span class="absolute top-1/2 left-1/2 grid h-10 w-10 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white text-[var(--color-ink)] shadow-lg">
        <Icon name="arrow" size={16} class="rotate-180" />
      </span>
    </div>
  </div>
</Section>

  <!-- Project grid -->
  <Section
    eyebrow={c.rosterSection.eyebrow}
    title={c.rosterSection.title}
    lead={c.rosterSection.lead}
  >
    <PortfolioGrid />
  </Section>

  <!-- Case studies — full business transformations -->
  <Section
    eyebrow={c.caseStudiesSection.eyebrow}
    title={c.caseStudiesSection.title}
    lead={c.caseStudiesSection.lead}
  >
    <div class="space-y-8">
      {projects.map((p) => {
        const body = c.projects[p.slug];
        if (!body) throw new Error(`PortfolioPage.astro: no content for project "${p.slug}" in portfolio.json (${lang})`);
        const img = p.image ? getImage(p.image) : undefined;
        const phases = [
          { label: c.sectionLabels.challenge, body: body.challenge },
          { label: c.sectionLabels.strategy, body: body.strategy },
          { label: c.sectionLabels.solution, body: body.solution },
        ];
        return (
        <article id={p.slug} class="reveal grid gap-8 rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-7 lg:grid-cols-12 lg:p-10" style={`--accent:${p.accent}`}>
          <!-- Media + technologies + visit -->
          <div class="lg:col-span-5">
            {img ? (
              <div class="aspect-video overflow-hidden rounded-2xl border border-[var(--border)]">
                <Image
                  src={img}
                  alt={`${p.name} — ${p.category} ${tChrome("card.imageAltSuffix", lang)}`}
                  widths={[400, 600, 800]}
                  sizes="(min-width: 1024px) 38vw, 92vw"
                  loading="lazy"
                  decoding="async"
                  format="webp"
                  class="h-full w-full object-cover"
                />
              </div>
            ) : (
              <div class="aspect-video overflow-hidden rounded-2xl" style={`background: radial-gradient(120% 120% at 0% 0%, color-mix(in srgb, ${p.accent} 55%, #111827), #111827 60%);`}>
                <div class="p-6">
                  <div class="flex gap-1.5">
                    <span class="h-2.5 w-2.5 rounded-full bg-white/30"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
                  </div>
                  <div class="mt-6 space-y-2.5">
                    <div class="h-3 w-2/3 rounded-full bg-white/25"></div>
                    <div class="h-2 w-1/2 rounded-full bg-white/15"></div>
                  </div>
                </div>
              </div>
            )}

            <!-- Technologies -->
            <div class="mt-5">
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--text-subtle)]">{c.sectionLabels.technologies}</p>
              <div class="mt-2.5 flex flex-wrap gap-2">
                {p.stack.map((tc) => (
                  <span class="rounded-full bg-[var(--surface-3)] px-3 py-1 text-xs font-semibold text-[var(--text-muted)]">{tc}</span>
                ))}
              </div>
            </div>

            {p.liveUrl && (
              <a
                href={p.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-transform hover:-translate-y-0.5"
                style={`background:${p.accent}`}
              >
                {c.sectionLabels.visitLiveSite}
                <Icon name="external" size={16} />
              </a>
            )}
          </div>

          <!-- Transformation narrative -->
          <div class="lg:col-span-7">
            <span class="text-xs font-bold uppercase tracking-[0.16em]" style={`color:${p.accent}`}>{p.category}</span>
            <h3 class="mt-2 font-display text-2xl font-extrabold tracking-tight">{p.name}</h3>
            <p class="mt-3 leading-relaxed text-[var(--text-muted)]">{body.overview}</p>

            <!-- Challenge → Strategy → Solution -->
            <div class="mt-6 space-y-4">
              {phases.map((s) => (
                <div class="border-l-2 pl-4" style={`border-color:${p.accent}`}>
                  <p class="text-xs font-bold uppercase tracking-[0.16em]" style={`color:${p.accent}`}>{s.label}</p>
                  <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-muted)]">{s.body}</p>
                </div>
              ))}
            </div>

            <!-- Outcome metrics -->
            <div class="mt-6 grid grid-cols-3 gap-4 border-t border-[var(--border)] pt-6">
              {p.results.map((r) => (
                <div>
                  <div class="font-display text-2xl font-extrabold" style={`color:${p.accent}`}>{r.metric}</div>
                  <div class="mt-0.5 text-xs font-semibold uppercase tracking-wide text-[var(--text-subtle)]">{r.label}</div>
                </div>
              ))}
            </div>
            <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]"><span class="font-semibold text-[var(--text)]">{c.sectionLabels.outcomeLabel} </span>{body.outcome}</p>

            <!-- Business impact -->
            <div class="mt-5 rounded-2xl p-5" style={`background: color-mix(in srgb, ${p.accent} 8%, transparent); border: 1px solid color-mix(in srgb, ${p.accent} 28%, transparent);`}>
              <p class="text-xs font-bold uppercase tracking-[0.16em]" style={`color:${p.accent}`}>{c.sectionLabels.businessImpact}</p>
              <p class="mt-1.5 text-sm font-medium leading-relaxed text-[var(--text)]">{body.businessImpact}</p>
            </div>
          </div>
        </article>
        );
      })}
    </div>
  </Section>

  <!-- Aggregate stats -->
  <Section class="!py-16">
    <div class="reveal grid grid-cols-2 gap-8 rounded-[var(--radius-xl2)] border border-[var(--border)] bg-[var(--surface-2)] p-10 lg:grid-cols-4">
      <AnimatedCounter value={40} suffix="+" label={c.statsLabels.sitesLaunched} />
      <AnimatedCounter value={1} suffix="M+" label={c.statsLabels.viewsDelivered} />
      <AnimatedCounter value={200} suffix="+" label={c.statsLabels.leadsCreated} />
      <AnimatedCounter value={100} suffix="%" label={c.statsLabels.clientRetention} />
    </div>
  </Section>

  <CTASection
    title={c.cta.title}
    body={c.cta.body}
  />

  <script>
    function initBA() {
      const slider = document.getElementById("ba-slider");
      const before = document.getElementById("ba-before");
      const handle = document.getElementById("ba-handle");
      if (!slider || !before || !handle || slider.dataset.init) return;
      slider.dataset.init = "true";

      let dragging = false;
      const set = (clientX: number) => {
        const r = slider.getBoundingClientRect();
        const pct = Math.min(Math.max((clientX - r.left) / r.width, 0), 1);
        before.style.clipPath = `inset(0 ${100 - pct * 100}% 0 0)`;
        handle.style.left = `${pct * 100}%`;
      };
      const start = () => (dragging = true);
      const end = () => (dragging = false);
      const move = (e: MouseEvent | TouchEvent) => {
        if (!dragging) return;
        const x = "touches" in e ? e.touches[0].clientX : (e as MouseEvent).clientX;
        set(x);
      };
      slider.addEventListener("mousedown", start);
      slider.addEventListener("touchstart", start, { passive: true });
      window.addEventListener("mouseup", end);
      window.addEventListener("touchend", end);
      window.addEventListener("mousemove", move);
      window.addEventListener("touchmove", move, { passive: true });
      // Click-to-position.
      slider.addEventListener("click", (e) => set((e as MouseEvent).clientX));
    }
    document.addEventListener("astro:page-load", initBA);
  </script>
</BaseLayout>
