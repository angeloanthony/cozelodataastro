---
/**
 * ServicesPage — THE template for /services/ (playbook §6.5, Step 24 of the
 * FAQ/i18n effort). One shared component implements the page; the master
 * route (/services/) and the dynamic localized route (/it/services/) both
 * render it.
 *
 * Three-tier content, same separation Step 21 established for FAQ:
 *   site.ts            -> service identity/structure (slug, index, icon,
 *                          image, reelVideoId, order) — never translated
 *   shared.json         -> title + short, via getServices() — multi-consumer
 *                          (footer, homepage ServicesGrid, and this page's
 *                          Service JSON-LD), joined on slug
 *   services.json        -> single-consumer page body copy (problem/why/
 *                          results/value/benefits/process/deliverables/cta),
 *                          keyed by the same slug
 *
 * serviceSchema reads from `services` (the getServices() result), so its
 * name/description are already in the rendering locale — /it/services/
 * describes itself in Italian, matching what CompanyPage/PricingPage already
 * do for locale-specific structured data.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../PageHero.astro";
import Section from "../Section.astro";
import CTASection from "../CTASection.astro";
import Icon from "../Icon.astro";
import { getLangFromUrl, t as tNav } from "../../data/i18n";
import { getPageContent, localizeHref, interp } from "../../i18n/content";
import { getServices } from "../../i18n/shared";
import { commercialFacts } from "../../data/site";

const lang = getLangFromUrl(Astro.url);
const c = getPageContent<any>("services", lang);
const services = getServices(lang);

const breadcrumbs = [
  { name: tNav("nav.home", lang), href: localizeHref("/", lang) },
  { name: c.breadcrumb, href: localizeHref("/services/", lang) },
];

const contactHref = localizeHref("/contact/", lang);

/** Resolve the {token} commercial-fact placeholders (Step 20). */
const t = (s: string) => interp(s, commercialFacts);

// Join site.ts/shared.json identity onto the localized body copy by `slug` —
// never by array position. A services.json missing a slug throws here (and
// fails i18n:check's structural mirror first).
function bodyFor(slug: string) {
  const entry = c.services[slug];
  if (!entry) throw new Error(`ServicesPage.astro: no content for service "${slug}" in services.json (${lang})`);
  return {
    problem: t(entry.problem),
    why: t(entry.why),
    results: t(entry.results),
    value: t(entry.value),
    benefits: entry.benefits as string[],
    process: entry.process as string[],
    deliverables: entry.deliverables as string[],
    cta: t(entry.cta),
  };
}

// Explainer video shown in the hero — technical identifier, not prose.
const heroVideoId = "Z8G8vGcDxss";

// Structured data for the six services documented below. Names and summaries
// come from `services` (already locale-correct), so the schema and the
// visible page never drift apart, in either language.
const serviceSchema = services.map((s) => ({
  name: s.title,
  description: s.short,
  path: `${localizeHref("/services/", lang)}#${s.slug}`,
}));
---
<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  breadcrumbs={breadcrumbs}
  services={serviceSchema}
>
  <PageHero
    eyebrow={c.hero.eyebrow}
    title={c.hero.title}
    lead={c.hero.lead}
    summary={t(c.hero.summary)}
    breadcrumbs={breadcrumbs}
  >
    <!-- Hero explainer video: floats gently, lifts toward you on hover -->
    <figure class="group w-full">
      <!-- Float layer (continuous bob; pauses while hovered) -->
      <div class="animate-float group-hover:[animation-play-state:paused]">
        <!-- Lift layer (interactive: rises + scales on hover) -->
        <div class="relative transition-transform duration-500 ease-out will-change-transform group-hover:-translate-y-2.5 group-hover:scale-[1.015]">
          <!-- Brand glow that blooms behind the frame on hover -->
          <div
            class="pointer-events-none absolute -inset-4 -z-10 rounded-[2rem] bg-[var(--color-brand)]/30 opacity-0 blur-2xl transition-opacity duration-500 group-hover:opacity-100"
            aria-hidden="true"
          ></div>
          <!-- The framed video -->
          <div class="overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] shadow-xl shadow-black/10 transition-shadow duration-500 ease-out group-hover:shadow-2xl group-hover:shadow-[var(--color-brand)]/25">
            <div class="aspect-video">
              <iframe
                class="h-full w-full"
                src={`https://www.youtube-nocookie.com/embed/${heroVideoId}`}
                title={c.hero.videoTitle}
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      </div>
      <figcaption class="mt-4 text-sm text-[var(--text-subtle)]">
        {c.hero.videoCaption}
      </figcaption>
    </figure>
  </PageHero>

  <!-- Orientation: where the six services sit relative to the rest of the site -->
  <Section class="!pt-12 !pb-0">
    <p class="reveal mx-auto max-w-3xl text-center text-lg leading-relaxed text-[var(--text-muted)]" set:html={c.orientationHtml} />
  </Section>

  {services.map((s) => {
    const body = bodyFor(s.slug);
    return (
    <Section id={s.slug} class="!py-16">
      {s.reelVideoId && (
        <!-- Full-width video reel, shown above the service copy. The copy below
             stays visible: the reel leads the section, it does not replace it. -->
        <figure class="group mb-12 w-full">
          <div class="animate-float group-hover:[animation-play-state:paused]">
            <div class="relative transition-transform duration-500 ease-out will-change-transform group-hover:-translate-y-2.5 group-hover:scale-[1.01]">
              <div
                class="pointer-events-none absolute -inset-4 -z-10 rounded-[2rem] bg-[var(--color-brand)]/30 opacity-0 blur-2xl transition-opacity duration-500 group-hover:opacity-100"
                aria-hidden="true"
              ></div>
              <div class="overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] shadow-xl shadow-black/10 transition-shadow duration-500 ease-out group-hover:shadow-2xl group-hover:shadow-[var(--color-brand)]/25">
                <div class="aspect-video">
                  <iframe
                    class="h-full w-full"
                    src={`https://www.youtube-nocookie.com/embed/${s.reelVideoId}?autoplay=1&mute=1&loop=1&playlist=${s.reelVideoId}&controls=1&modestbranding=1&rel=0&playsinline=1`}
                    title={s.title}
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  ></iframe>
                </div>
              </div>
            </div>
          </div>
        </figure>
      )}
      <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
        <!-- Left: intro -->
        <div class="reveal lg:col-span-5 lg:sticky lg:top-28">
          <div class="flex items-center gap-4">
            <span class="grid h-14 w-14 place-items-center rounded-2xl bg-[var(--color-brand)]/10 text-[var(--color-brand)]">
              <Icon name={s.icon} size={26} />
            </span>
            <span class="font-mono text-sm text-[var(--text-subtle)]">{s.index} / {s.title.split(" ")[0].toUpperCase()}</span>
          </div>
          <h2 class="mt-5 font-display text-3xl font-extrabold tracking-tight">{s.title}</h2>
          <p class="mt-3 text-lg text-[var(--text-muted)]">{s.short}</p>

          <div class="mt-6 space-y-4">
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-5">
              <h3 class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-brand)]">{c.sectionLabels.problem}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{body.problem}</p>
            </div>
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-5">
              <h3 class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-brand)]">{c.sectionLabels.solution}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{body.why}</p>
            </div>
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-5">
              <h3 class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-brand)]">{c.sectionLabels.benefit}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{body.results}</p>
            </div>
            <div class="rounded-2xl border border-[var(--color-brand)]/30 bg-[var(--color-brand)]/[0.06] p-5">
              <h3 class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-brand)]">{c.sectionLabels.value}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{body.value}</p>
            </div>
          </div>

          <a href={contactHref} class="mt-6 inline-flex items-center gap-2 rounded-full bg-[var(--color-brand)] px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5">
            {body.cta}<Icon name="arrow" size={16} />
          </a>
        </div>

        <!-- Right: benefits / process / deliverables -->
        <div class="reveal space-y-6 lg:col-span-7" data-delay="120">
          <div class="rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-7">
            <h3 class="font-display text-lg font-bold tracking-tight">{c.sectionLabels.benefits}</h3>
            <ul class="mt-4 grid gap-3 sm:grid-cols-2">
              {body.benefits.map((b) => (
                <li class="flex items-start gap-2.5 text-sm text-[var(--text-muted)]">
                  <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-[var(--color-brand)]/15 text-[var(--color-brand)]"><Icon name="check" size={13} /></span>
                  {b}
                </li>
              ))}
            </ul>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div class="rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-7">
              <h3 class="font-display text-lg font-bold tracking-tight">{c.sectionLabels.process}</h3>
              <ol class="mt-4 space-y-3">
                {body.process.map((step, n) => (
                  <li class="flex items-center gap-3 text-sm text-[var(--text-muted)]">
                    <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-[var(--color-brand)]/40 font-mono text-xs font-bold text-[var(--color-brand)]">{n + 1}</span>
                    {step}
                  </li>
                ))}
              </ol>
            </div>
            <div class="rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-7">
              <h3 class="font-display text-lg font-bold tracking-tight">{c.sectionLabels.deliverables}</h3>
              <ul class="mt-4 space-y-3">
                {body.deliverables.map((d) => (
                  <li class="flex items-center gap-2.5 text-sm text-[var(--text-muted)]">
                    <Icon name="doc" size={16} class="shrink-0 text-[var(--color-brand)]" />{d}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </Section>
    );
  })}

  <!--
    The secondary action points at /faq/ rather than /portfolio/. Two reasons:
    /portfolio/ is already linked editorially in the orientation paragraph
    above (the duplicate flagged in master-map F2), and /faq/ linked here
    previously had no return link from this page — the guide asks internal
    links to run in both directions. Objections about timeline, ownership, and
    cost are the logical next step for someone still choosing a service.
  -->
  <CTASection
    title={c.cta.title}
    body={c.cta.body}
    secondaryLabel={c.cta.secondaryLabel}
    secondaryHref="/faq/"
  />
</BaseLayout>
