---
/**
 * AnimatedCounter — counts up from 0 to `value` when scrolled into view.
 * Animation logic lives in main.ts (data-counter / data-suffix attributes).
 */
interface Props {
  value: number;
  suffix?: string;
  label: string;
  class?: string;
}
const { value, suffix = "", label, class: className = "" } = Astro.props;
---
<div class:list={["text-center", className]}>
  <div
    class="font-display text-4xl font-extrabold tracking-tight text-[var(--text)] sm:text-5xl tabular-nums"
    data-counter={value}
    data-suffix={suffix}
    aria-label={`${value}${suffix} ${label}`}
  >
    0{suffix}
  </div>
  <div class="mt-2 text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-subtle)]">
    {label}
  </div>
</div>
