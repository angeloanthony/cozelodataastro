---
/**
 * Guarantees — the concrete promises that de-risk hiring Cozelos Data. Built
 * from real commitments already made across the site (ownership, fixed quotes,
 * performance, responsiveness, security, month-to-month plans).
 *
 * Presentation only. /pricing/ is this section's single consumer, so its copy
 * lives in that page's JSON and arrives as props — the same split every other
 * page component uses.
 */
import Section from "./Section.astro";
import Icon from "./Icon.astro";

interface Guarantee { icon: string; title: string; body: string }
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  items: Guarantee[];
}
const { eyebrow, title, lead, items } = Astro.props;
---
<Section
  eyebrow={eyebrow}
  title={title}
  lead={lead}
>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((g, i) => (
      <div
        data-delay={i * 50}
        class="reveal flex gap-4 rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-6 transition-colors duration-300 hover:border-[var(--color-brand)]/40"
      >
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-[var(--color-brand)]/10 text-[var(--color-brand)]">
          <Icon name={g.icon} size={22} />
        </span>
        <div>
          <h3 class="font-display text-base font-bold tracking-tight">{g.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-muted)]">{g.body}</p>
        </div>
      </div>
    ))}
  </div>
</Section>
