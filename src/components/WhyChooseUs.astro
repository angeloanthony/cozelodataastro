---
/**
 * WhyChooseUs — the differentiators that separate a Cozelos Data digital asset
 * from a commodity website. Outcome-first, not feature-first.
 */
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import Button from "./Button.astro";

const reasons = [
  {
    icon: "bolt",
    title: "Systems, not pages",
    body: "We connect design, SEO, marketing, and automation into one system engineered to compound — not a disconnected set of deliverables.",
  },
  {
    icon: "clock",
    title: "Engineered for speed",
    body: "Sub-second load times, built by hand. Faster sites rank higher, convert more, and respect every visitor's time.",
  },
  {
    icon: "search",
    title: "Built to be found",
    body: "SEO and AI-search architecture are baked in from day one, so the right customers find you the moment they're looking.",
  },
  {
    icon: "lock",
    title: "You own everything",
    body: "Your domain, your code, your content. No proprietary lock-ins, no hostage retainers — just assets that belong to you.",
  },
  {
    icon: "target",
    title: "Measured by results",
    body: "We report on the outcomes that matter — leads, rankings, and revenue — not vanity metrics that only look good on a slide.",
  },
  {
    icon: "shield",
    title: "A long-term partner",
    body: "Every milestone documented, every site monitored and improving. We stay invested long after launch day.",
  },
];
---
<Section
  eyebrow="Why Cozelos Data"
  title="Why ambitious businesses choose us."
  lead="A website is a cost. A growth platform is a competitive advantage. Here's what sets ours apart."
>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {reasons.map((r, i) => (
      <div
        class="reveal group rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-7 transition-[border-color,box-shadow] duration-300 hover:border-[var(--color-brand)]/40 hover:shadow-xl hover:shadow-[var(--color-brand)]/5"
        data-delay={i * 60}
      >
        <span class="grid h-12 w-12 place-items-center rounded-2xl bg-[var(--color-brand)]/10 text-[var(--color-brand)] transition-all duration-300 group-hover:scale-110 group-hover:bg-[var(--color-brand)] group-hover:text-white">
          <Icon name={r.icon} size={22} />
        </span>
        <h3 class="mt-5 font-display text-lg font-bold tracking-tight">{r.title}</h3>
        <p class="mt-2 leading-relaxed text-[var(--text-muted)]">{r.body}</p>
      </div>
    ))}
  </div>
  <div class="mt-10 flex justify-center">
    <Button href="/why-cozelos-data/" variant="secondary" size="lg" icon="arrow">See why businesses choose us</Button>
  </div>
</Section>
