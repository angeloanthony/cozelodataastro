---
/**
 * Footer — contact details, service links, government credentials, and social.
 */
import { Image } from "astro:assets";
import { site } from "../data/site";
import Icon from "./Icon.astro";
import { getImage } from "../lib/images";
import { getLangFromUrl, t } from "../data/i18n";
import { localizeHref, interp } from "../i18n/content";
import { getServices, getShared } from "../i18n/shared";

const year = new Date().getFullYear();
const logoImg = getImage("cozeloslogo.webp");

// Same rule as the header: internal hrefs go through the one existence-aware
// helper. tel:, mailto:, external URLs and /sitemap-index.xml are untouched —
// localizeHref only rewrites a path whose slug has a committed translation.
const lang = getLangFromUrl(Astro.url);
const L = (href: string) => localizeHref(href, lang);
// Service labels come from the shared source (domain 3), joined on site.ts slugs.
const services = getServices(lang);
// Footer prose + link labels are shared content (domain 3): they render on every
// page, so translating them per page would let the copies drift.
const sh = getShared(lang);
const f = sh.footer;
---
<footer class="relative mt-24 border-t border-[var(--border)] bg-[var(--surface-2)]">
  <!-- Brand reinforcement band -->
  <div class="border-b border-[var(--border)]">
    <div class="container-x py-14 text-center">
      <p class="font-display text-2xl font-extrabold leading-[1.2] tracking-tight sm:text-3xl">
{f.brandHeadline}</p>
      <p class="mt-2 font-display text-lg font-semibold text-[var(--text-muted)] sm:text-xl">
{f.tagline}</p>
      <p class="mt-4 text-sm text-[var(--text-subtle)]">
{f.locality}</p>
    </div>
  </div>

  <div class="container-x py-16">
    <div class="grid gap-12 lg:grid-cols-12">
      <!-- Brand -->
      <div class="lg:col-span-4">
        <a href={L("/")} class="flex items-center gap-2.5" aria-label={t("a11y.home", lang, { brand: site.name })}>
          {logoImg ? (
            <Image
              src={logoImg}
              alt={site.name}
              width={160}
              loading="lazy"
              class="h-9 w-auto"
            />
          ) : (
            <span class="grid h-9 w-9 place-items-center rounded-xl bg-[var(--color-brand)] font-display text-sm font-extrabold text-white">CD</span>
          )}
          <span class="font-display text-lg font-extrabold tracking-tight">
            Cozelos<span class="text-[var(--color-brand)]">.</span>Data
          </span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-[var(--text-muted)]">
{f.description}</p>
        <div class="mt-6 flex gap-3">
          <a href={site.social.facebook} aria-label="Facebook" class="grid h-10 w-10 place-items-center rounded-xl border border-[var(--border)] text-[var(--text-muted)] transition-colors hover:border-[var(--color-brand)] hover:text-[var(--color-brand)]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 9h3l.5-3H14V4.5c0-.9.3-1.5 1.6-1.5H17V.3C16.6.2 15.6 0 14.5 0 12 0 10.5 1.5 10.5 4v2H8v3h2.5v9h3.5V9z"/></svg>
          </a>
          <a href={site.social.instagram} aria-label="Instagram" class="grid h-10 w-10 place-items-center rounded-xl border border-[var(--border)] text-[var(--text-muted)] transition-colors hover:border-[var(--color-brand)] hover:text-[var(--color-brand)]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/></svg>
          </a>
          <a href={site.social.linkedin} aria-label="LinkedIn" class="grid h-10 w-10 place-items-center rounded-xl border border-[var(--border)] text-[var(--text-muted)] transition-colors hover:border-[var(--color-brand)] hover:text-[var(--color-brand)]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5A2.5 2.5 0 1 1 0 3.5a2.5 2.5 0 0 1 4.98 0zM.5 8h4V24h-4V8zM8 8h3.8v2.2h.05c.53-1 1.83-2.2 3.77-2.2 4.03 0 4.78 2.65 4.78 6.1V24h-4v-7.2c0-1.72-.03-3.92-2.4-3.92-2.4 0-2.77 1.87-2.77 3.8V24H8V8z"/></svg>
          </a>
        </div>
        <a
          href={site.googleReviewHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-2 rounded-xl border border-[var(--border)] px-4 py-2.5 text-sm font-semibold text-[var(--text-muted)] transition-colors hover:border-[var(--color-brand)] hover:text-[var(--color-brand)]"
        >
          <Icon name="star" size={16} class="fill-current text-[var(--color-brand)]" />
          {f.review}
        </a>
      </div>

      <!-- Services -->
      <div class="lg:col-span-3">
        <h3 class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--text-subtle)]">{t("footer.services", lang)}</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {services.map((s) => (
            <li>
              <a href={L(`/services/#${s.slug}`)} class="link-underline text-[var(--text-muted)] transition-colors hover:text-[var(--text)]">
                {s.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div class="lg:col-span-2">
        <h3 class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--text-subtle)]">{t("footer.company", lang)}</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href={L("/company/")} class="link-underline text-[var(--text-muted)] hover:text-[var(--text)]">{f.about}</a></li>
          <li><a href={L("/ellen-cozelos/")} class="link-underline text-[var(--text-muted)] hover:text-[var(--text)]">{f.ellen}</a></li>
          <li><a href={L("/why-cozelos-data/")} class="link-underline text-[var(--text-muted)] hover:text-[var(--text)]">{f.why}</a></li>
          <li><a href={L("/our-approach/")} class="link-underline text-[var(--text-muted)] hover:text-[var(--text)]">{f.approach}</a></li>
          <li><a href={L("/pricing/")} class="link-underline text-[var(--text-muted)] hover:text-[var(--text)]">{t("nav.pricing", lang)}</a></li>
          <li><a href={L("/portfolio/")} class="link-underline text-[var(--text-muted)] hover:text-[var(--text)]">{t("nav.portfolio", lang)}</a></li>
          <li><a href={L("/faq/")} class="link-underline text-[var(--text-muted)] hover:text-[var(--text)]">{f.faq}</a></li>
          <li><a href={L("/company/#government")} class="link-underline text-[var(--text-muted)] hover:text-[var(--text)]">{f.government}</a></li>
          <li><a href={L("/contact/")} class="link-underline text-[var(--text-muted)] hover:text-[var(--text)]">{t("nav.contact", lang)}</a></li>
          <li><a href={L("/payment/")} class="link-underline text-[var(--text-muted)] hover:text-[var(--text)]">{f.payment}</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="lg:col-span-3">
        <h3 class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--text-subtle)]">{t("footer.contact", lang)}</h3>
        <ul class="mt-4 space-y-3 text-sm text-[var(--text-muted)]">
          <li class="flex items-start gap-2.5">
            <Icon name="pin" size={16} class="mt-0.5 shrink-0 text-[var(--color-brand)]" />
            <span>{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postal}</span>
          </li>
          <li class="flex items-center gap-2.5">
            <Icon name="phone" size={16} class="shrink-0 text-[var(--color-brand)]" />
            <a href={site.phoneHref} class="font-semibold text-[var(--text)] hover:text-[var(--color-brand)]">{site.phone}</a>
          </li>
          <li class="flex items-center gap-2.5">
            <Icon name="mail" size={16} class="shrink-0 text-[var(--color-brand)]" />
            <a href={site.emailHref} class="hover:text-[var(--text)]">{site.email}</a>
          </li>
          <li class="flex items-center gap-2.5">
            <Icon name="clock" size={16} class="shrink-0 text-[var(--color-brand)]" />
            <span>{interp(sh.business.hours, site.hours)}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Credentials strip -->
    <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-2 rounded-2xl border border-[var(--border)] bg-[var(--surface)] px-5 py-4 text-xs font-medium text-[var(--text-muted)]">
      <span class="inline-flex items-center gap-2 font-semibold text-[var(--text)]"><Icon name="award" size={15} class="text-[var(--color-brand)]" />{site.credentials.wosb}</span>
      <span>DUNS: <span class="font-mono text-[var(--text)]">{site.credentials.duns}</span></span>
      <span>CAGE: <span class="font-mono text-[var(--text)]">{site.credentials.cage}</span></span>
      <span>NAICS: <span class="font-mono text-[var(--text)]">{site.credentials.naics.join(", ")}</span></span>
    </div>

    <div class="mt-8 flex flex-col items-center justify-between gap-3 border-t border-[var(--border)] pt-6 text-xs text-[var(--text-subtle)] sm:flex-row">
      <p>{interp(f.copyright, { year, brand: site.name })}</p>
      <div class="flex gap-5">
        <a href={L("/privacy/")} class="hover:text-[var(--text)]">{f.privacy}</a>
        <a href={L("/terms/")} class="hover:text-[var(--text)]">{f.terms}</a>
        <a href="/sitemap-index.xml" class="hover:text-[var(--text)]">{f.sitemap}</a>
      </div>
    </div>
  </div>
</footer>
