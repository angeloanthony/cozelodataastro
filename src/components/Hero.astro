---
/**
 * Hero — full-bleed background image (when present) with text + glass cards
 * floating on top. Falls back to the animated grid + blobs when no image.
 *
 * Locale-aware (Step 27): props default to the English copy below so this
 * component is unaffected when no props are passed; HomePage.astro is the
 * only caller and supplies localized copy from home.json's `hero`, plus
 * `lang` so the two buttons resolve to /it/contact/ and /it/portfolio/.
 *
 * The rotating word ("Businesses. → Revenues. → Reach.") is typed by
 * main.ts's initWordRotator, a plain DOM script with no access to the i18n
 * content system. `rotatingWords` is serialized onto the element's
 * `data-words` attribute; the script reads that JSON if present and falls
 * back to its own hardcoded English array otherwise, so it keeps working for
 * any other future caller that doesn't set the attribute.
 */
import { Image } from "astro:assets";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import AiSummary from "./AiSummary.astro";
import { getImage } from "../lib/images";
import { commercialFacts } from "../data/site";
import { getLangFromUrl } from "../data/i18n";
import { localizeHref } from "../i18n/content";
import { getShared } from "../i18n/shared";

const heroImage = getImage("hero/digital-ecosystem.webp");

interface HeroCards {
  lighthouseLabel: string;
  performanceValue: string;
  performanceLabel: string;
  rankingLabel: string;
  rankingValue: string;
  rankingCaption: string;
  loadTimeLabel: string;
  loadTimeValue: string;
  loadTimeCaption: string;
  businessesBadge: string;
  businessesCaption: string;
}
interface Props {
  badge?: string;
  h1Prefix?: string;
  h1GradientLead?: string;
  rotatingWords?: string[];
  tagline?: string;
  kicker?: string;
  lead?: string;
  summaryHtml?: string;
  primaryCta?: string;
  secondaryCta?: string;
  trust?: { fromPrice: string; ownEverything: string; noLockIns: string };
  cards?: HeroCards;
}
const {
  badge = "Woman-Owned Small Business · Vernal, Utah",
  h1Prefix = "We Build Digital Assets That",
  h1GradientLead = "Grow",
  rotatingWords = ["Businesses.", "Revenues.", "Reach."],
  tagline = "Making Businesses Stronger. Making Life Better.",
  kicker = "Fast. Secure. Built to Rank.",
  lead = "We design and engineer complete digital systems that generate leads, build authority, and create long-term growth.",
  summaryHtml = "Cozelos Data is a Woman-Owned digital agency in Vernal, Utah building custom websites, SEO, video, and marketing for local and government businesses. Custom projects start at {websiteStartingPrice}, load in under a second, and you own everything — the domain, code, and content.",
  primaryCta,
  secondaryCta,
  trust = { fromPrice: "From {websiteStartingPrice}", ownEverything: "You own everything", noLockIns: "No lock-ins" },
  cards = {
    lighthouseLabel: "Lighthouse",
    performanceValue: "99",
    performanceLabel: "Performance",
    rankingLabel: "Ranking",
    rankingValue: "#1",
    rankingCaption: "Local search",
    loadTimeLabel: "Load Time",
    loadTimeValue: "0.9s",
    loadTimeCaption: "First paint",
    businessesBadge: "35+ Businesses",
    businessesCaption: "Served across Utah",
  },
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const cta = getShared(lang).cta;
const primaryLabel = primaryCta ?? cta.start;
const secondaryLabel = secondaryCta ?? cta.work;
const contactHref = localizeHref("/contact/", lang);
const portfolioHref = localizeHref("/portfolio/", lang);

// {websiteStartingPrice} is the only token either string carries (Step 20).
const summaryText = summaryHtml.replaceAll("{websiteStartingPrice}", commercialFacts.websiteStartingPrice);
const trustFromPrice = trust.fromPrice.replaceAll("{websiteStartingPrice}", commercialFacts.websiteStartingPrice);
---
{heroImage && (
  <div class="pointer-events-none fixed inset-0 -z-50 overflow-hidden">
    <div class="hero-pan absolute -inset-10">
      <Image
        src={heroImage}
        alt=""
        widths={[900, 1400, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        format="webp"
        class="h-full w-full object-cover opacity-85"
      />
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-[var(--surface)] via-[var(--surface)]/70 to-transparent"></div>
  </div>
)}



<section
  data-pointer-stage
  class="hero-section relative isolate overflow-hidden pt-10 pb-8 sm:pt-12 sm:pb-8"
  style="--spot-x:50%;--spot-y:30%;"
>
  
  <!-- Animated grid backdrop -->
  <div class="bg-grid pointer-events-none absolute inset-0 -z-20 opacity-40" aria-hidden="true"></div>

  <!-- Mouse-follow spotlight -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 transition-opacity duration-500"
    aria-hidden="true"
    style="background: radial-gradient(420px circle at var(--spot-x) var(--spot-y), color-mix(in srgb, var(--color-brand) 16%, transparent), transparent 70%);"
  ></div>

  <!-- Morphing blobs -->
  <div class="pointer-events-none absolute -left-24 top-20 -z-20 h-72 w-72 bg-[var(--color-brand)]/15 blur-3xl" style="animation: blob 18s ease-in-out infinite;" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-16 bottom-0 -z-20 h-80 w-80 bg-orange-500/10 blur-3xl" style="animation: blob 22s ease-in-out infinite reverse;" aria-hidden="true"></div>

  <div class="container-x">
    <div class="hero-grid grid items-center gap-12 lg:grid-cols-12">
      <!-- Copy -->
      <div class="hero-copy lg:col-span-8">
        <div class="hero-badge reveal inline-flex items-center gap-2 rounded-full border border-[var(--border-strong)] bg-[var(--surface-2)] px-3.5 py-1.5 text-xs font-semibold text-[var(--text-muted)]">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-brand)] opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-brand)]"></span>
          </span>
          {badge}
        </div>

        <h1 class="hero-h1 reveal mt-6 font-display text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-[2.75rem] lg:text-[3.35rem]" data-delay="80">
          {h1Prefix}
          <span class="text-gradient">{h1GradientLead && `${h1GradientLead} `}<span class="hero-rotate"><span class="text-gradient hero-rotate-text" data-word-rotate data-words={JSON.stringify(rotatingWords)}>{rotatingWords[0]}</span></span></span>
        </h1>

        <p class="reveal mt-4 font-display text-lg font-semibold tracking-tight text-[var(--text-muted)] sm:text-xl" data-delay="120">
          {tagline}
        </p>

        <p class="reveal mt-4 text-sm font-bold uppercase tracking-[0.18em] text-[var(--color-brand)]" data-delay="150">
          {kicker}
        </p>

        <p class="hero-lead reveal mt-6 max-w-xl text-lg leading-relaxed text-[var(--text-muted)]" data-delay="180">
          {lead}
        </p>

        <!-- The AI summary is the block AI Overviews cite, so it must exist in
             the *mobile* rendering — Google indexes mobile-first, and content in
             display:none is discounted. It therefore renders on every viewport;
             on phones CSS moves it below the trust row (see .hero-copy in the
             style block) so the fold stays scannable. Desktop is unchanged. -->
        <AiSummary class="hero-summary mt-7">
          {summaryText}
        </AiSummary>

        <div class="hero-actions reveal mt-9 flex flex-wrap items-center gap-4" data-delay="240">
          <Button href={contactHref} size="lg" magnetic icon="arrow">{primaryLabel}</Button>
          <Button href={portfolioHref} size="lg" variant="secondary">{secondaryLabel}</Button>
        </div>

        <div class="hero-trust reveal mt-8 flex items-center gap-5 text-sm text-[var(--text-subtle)]" data-delay="320">
          <span class="inline-flex items-center gap-1.5"><Icon name="check" size={16} class="text-[var(--color-brand)]" /> {trustFromPrice}</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="check" size={16} class="text-[var(--color-brand)]" /> {trust.ownEverything}</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="check" size={16} class="text-[var(--color-brand)]" /> {trust.noLockIns}</span>
        </div>
      </div>

      <!-- Floating glass cards -->
      <div class="hero-cards relative lg:col-span-4">
        <div class="hero-cards-stage relative mx-auto h-[420px] max-w-md">
          <!-- Main glass card -->
          <div
            data-float="18"
            class="glass reveal absolute left-1/2 top-6 w-72 -translate-x-1/2 rounded-3xl p-5 shadow-2xl shadow-black/10"
            data-delay="200"
          >
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold uppercase tracking-wider text-[var(--text-subtle)]">{cards.lighthouseLabel}</span>
              <Icon name="bolt" size={16} class="text-[var(--color-brand)]" />
            </div>
            <div class="mt-3 flex items-end gap-3">
              <span class="font-display text-5xl font-extrabold text-[var(--text)]">{cards.performanceValue}</span>
              <span class="mb-2 text-sm text-[var(--text-muted)]">{cards.performanceLabel}</span>
            </div>
            <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-[var(--surface-3)]">
              <div class="h-full w-[99%] rounded-full bg-gradient-to-r from-[var(--color-brand)] to-orange-500"></div>
            </div>
          </div>

          <!-- Floating mini cards -->
          <div data-float="34" class="glass reveal absolute -left-2 top-44 w-44 rounded-2xl p-4 shadow-xl shadow-black/10" data-delay="320">
            <div class="flex items-center gap-2 text-[var(--color-brand)]"><Icon name="search" size={16} /><span class="text-xs font-bold uppercase tracking-wide text-[var(--text)]">{cards.rankingLabel}</span></div>
            <p class="mt-2 font-display text-2xl font-extrabold">{cards.rankingValue}</p>
            <p class="text-xs text-[var(--text-subtle)]">{cards.rankingCaption}</p>
          </div>

          <div data-float="26" class="glass reveal absolute right-0 top-56 w-48 rounded-2xl p-4 shadow-xl shadow-black/10" data-delay="400">
            <div class="flex items-center gap-2 text-[var(--color-brand)]"><Icon name="clock" size={16} /><span class="text-xs font-bold uppercase tracking-wide text-[var(--text)]">{cards.loadTimeLabel}</span></div>
            <p class="mt-2 font-display text-2xl font-extrabold">{cards.loadTimeValue}</p>
            <p class="text-xs text-[var(--text-subtle)]">{cards.loadTimeCaption}</p>
          </div>

          <div data-float="44" class="glass reveal absolute bottom-2 left-10 flex items-center gap-3 rounded-2xl px-4 py-3 shadow-xl shadow-black/10" data-delay="480">
            <span class="grid h-9 w-9 place-items-center rounded-xl bg-[var(--color-brand)] text-white"><Icon name="star" size={18} /></span>
            <div>
              <p class="font-display text-sm font-bold leading-none">{cards.businessesBadge}</p>
              <p class="mt-1 text-xs text-[var(--text-subtle)]">{cards.businessesCaption}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /*
    Rotating hero word — typewriter effect cycling "Businesses → Revenues →
    Reach". JS types one character at a time (see initWordRotator in main.ts);
    the static word renders without JS, so the headline is fully functional
    unenhanced.

    .hero-rotate is a fixed-width reservation box: JS sets its min-width to the
    widest word so the rest of the headline NEVER reflows as the word changes
    length (otherwise "Assets" jumps between rows). The period is part of the
    typed word, so shorter words leave only invisible trailing whitespace at the
    end of the line — no gap before the period.
  */
  .hero-rotate {
    display: inline-block;
    text-align: left;
    white-space: nowrap;
  }
  /* The caret is a border on the text span so it hugs the typed characters
     rather than the right edge of the reservation box. The text is
     gradient/transparent, so the caret needs an explicit brand color. */
  .hero-rotate-text {
    border-right: 0.08em solid var(--color-brand-500);
    padding-right: 0.04em;
  }
  /* Only blink the caret once JS takes over, so the no-JS state is static. */
  .hero-rotate-text.is-typing {
    animation: hero-caret 1s steps(1) infinite;
  }
  @keyframes hero-caret {
    50% { border-color: transparent; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-rotate-text.is-typing { animation: none; }
  }

  /*
    Mobile hero layout (≤768px). Desktop (≥769px) is completely untouched —
    every rule lives inside the media query and is namespaced under
    .hero-section, so nothing leaks to other breakpoints or sections.
    (is:global is used because .hero-summary lives on the AiSummary child
    component's root, which Astro's component-scoped styles wouldn't reach.)

    The header is position:fixed, so the hero must reserve space for it instead
    of sliding underneath. We offset by the real header height (--header-h,
    defined in global.css) plus ~20px of breathing room — derived, not guessed,
    so spacing stays consistent across every phone width.
  */
  @media (max-width: 768px) {
    .hero-section {
      /* header height + ~20px breathing room (within the 16–24px target) */
      padding-top: calc(var(--header-h) + 1.25rem);
      padding-bottom: 1.5rem;
    }

    /* ~10–15% smaller than the previous mobile size, still bold & fluid. */
    .hero-section .hero-h1 {
      font-size: clamp(1.6rem, 4.4vw + 0.5rem, 2.2rem);
      line-height: 1.12;
    }

    /* Tighten the vertical rhythm so the whole hero fits one viewport. */
    .hero-section .hero-h1 { margin-top: 0.875rem; }   /* was mt-6  (24px) */
    .hero-section .hero-lead { margin-top: 0.875rem; } /* was mt-6  (24px) */
    .hero-section .hero-actions { margin-top: 1.5rem; } /* was mt-9 (36px) */
    .hero-section .hero-trust { margin-top: 1rem; }    /* was mt-8  (32px) */

    /*
      CTAs side-by-side on one row. At full size the two buttons (~169px each)
      can't share a phone row, so they flex to fill it instead of wrapping —
      which also gives big, thumb-friendly targets. The primary "Get a Quote"
      gets extra grow weight so it reads as the dominant action; trimmed
      horizontal padding keeps both labels on one line. Height (py-3.5) is
      untouched, so touch targets stay large.
    */
    .hero-section .hero-actions { flex-wrap: nowrap; gap: 0.75rem; }
    .hero-section .hero-actions > a {
      flex: 1 1 0;
      min-width: 0;
      padding-left: 0.875rem;
      padding-right: 0.875rem;
    }
    /* Primary reads as dominant, but only a modest grow so the secondary label
       still fits on one line down to 375px. */
    .hero-section .hero-actions > a:first-child { flex-grow: 1.18; }

    /* Pull the decorative card stage closer to the copy (was gap-12 / 48px). */
    .hero-section .hero-grid { gap: 1.5rem; }

    /*
      AI summary on mobile. It used to be display:none here, which meant the
      mobile-indexed page — the one Google actually reads — carried no summary
      block for AI Overviews to cite. It now renders on every viewport; flex
      ordering moves it to the end of the copy column on phones so the headline,
      CTAs, and trust row still own the fold exactly as before.

      Only the ORDER changes: the children are block-level with margin-top only,
      so flex column layout reproduces the same vertical rhythm. Desktop never
      enters this media query and keeps normal block flow.

      One exception has to be handled explicitly. Flex blockifies its items, and
      the default cross-axis alignment is `stretch` — which would turn the
      inline-flex WOSB pill into a full-width bar. It is the only inline-level
      child, so it alone gets `align-self: flex-start` to keep shrink-to-fit
      sizing. Everything else is block-level and stretches to the same width it
      already had.
    */
    .hero-section .hero-copy { display: flex; flex-direction: column; }
    .hero-section .hero-badge { align-self: flex-start; }
    .hero-section .hero-summary { order: 99; margin-top: 1.25rem; }

    /*
      Keep the floating glass cards on mobile — just smaller and lighter.
      The cluster is a 420px-tall box of absolutely-positioned cards, so we
      scale the whole stage down rather than re-flowing each card. transform
      doesn't shrink the layout box, so the negative margin-bottom reclaims the
      empty space the scale leaves behind (height × (scale − 1)). It renders
      below the copy with no text overlap, peeking up from the fold as a premium
      accent instead of dominating the screen.
    */
    .hero-section .hero-cards-stage {
      --cards-scale: 0.72; /* 72% of desktop — within the 65–75% target */
      transform: scale(var(--cards-scale));
      transform-origin: top center;
      margin-bottom: calc(420px * (var(--cards-scale) - 1)); /* −117.6px */
    }
  }

  /* Very small phones (≤360px, e.g. 320px): scale the cards a touch more and
     soften them slightly so they read as a background accent, not clutter.
     Still visible — no need to hide them. (Scale lives on .hero-cards-stage so
     the layout-reclaiming margin stays in sync; opacity goes on the wrapper.) */
  @media (max-width: 360px) {
    .hero-section .hero-cards-stage { --cards-scale: 0.65; }
    .hero-section .hero-cards { opacity: 0.9; }

    /* Two full-size CTAs can't fit one row this narrow — stack them full-width
       (premium app-style), primary on top. Large, easy thumb targets. */
    .hero-section .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-section .hero-actions > a { flex-basis: auto; }
  }
</style>
