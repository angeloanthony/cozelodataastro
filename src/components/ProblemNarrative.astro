---
/**
 * ProblemNarrative — the emotional opening of the homepage story. Frames the
 * stakes from the customer's point of view before any pitch.
 */
import Section from "./Section.astro";
---
<Section class="!py-16">
  <div class="reveal mx-auto max-w-3xl text-center">
    <p class="font-display text-2xl font-extrabold leading-[1.25] tracking-tight sm:text-3xl">
      Every day, potential customers search for businesses like yours.
    </p>
    <p class="mt-4 font-display text-xl font-semibold leading-snug text-[var(--text-muted)] sm:text-2xl">
      Some find your competitors.<br />Some never find you at all.
    </p>
    <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-[var(--text-muted)]">
      Your online presence should be your
      <span class="font-semibold text-[var(--text)]">hardest-working employee</span> —
      earning trust, generating leads, and creating opportunities 24 hours a day.
      That&rsquo;s why we build digital systems, not just websites.
    </p>
  </div>
</Section>
