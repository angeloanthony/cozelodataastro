---
/**
 * Philosophy — the four convictions behind every Cozelos Data build, shown as a
 * deliberate progression from attention to growth.
 */
import Section from "./Section.astro";
import Button from "./Button.astro";

const pillars = [
  {
    n: "01",
    title: "Beautiful design earns attention.",
    body: "First impressions happen in milliseconds. Cinematic, intentional design earns the trust to keep someone reading.",
  },
  {
    n: "02",
    title: "Performance keeps visitors engaged.",
    body: "Speed is respect. Sub-second loads and seamless motion hold attention instead of testing patience.",
  },
  {
    n: "03",
    title: "SEO brings customers.",
    body: "Visibility is the difference between a brochure and a pipeline. We build to be found by the people already searching for you.",
  },
  {
    n: "04",
    title: "Strategy turns customers into growth.",
    body: "Design, speed, and search only matter when aimed at outcomes. Every decision ladders up to revenue.",
  },
];
---
<Section
  eyebrow="Our Philosophy"
  title="Four convictions behind every build."
  lead="Great digital work isn't a pile of features. It's a sequence — each layer earning the next."
>
  <div class="grid gap-px overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--border)] sm:grid-cols-2">
    {pillars.map((p, i) => (
      <div
        class="reveal group relative bg-[var(--surface-2)] p-8 transition-colors duration-300 hover:bg-[var(--surface-3)] sm:p-10"
        data-delay={i * 80}
      >
        <span class="font-mono text-sm font-semibold text-[var(--color-brand)]">{p.n}</span>
        <h3 class="mt-4 font-display text-xl font-bold leading-snug tracking-tight sm:text-2xl">{p.title}</h3>
        <p class="mt-3 leading-relaxed text-[var(--text-muted)]">{p.body}</p>
      </div>
    ))}
  </div>
  <div class="mt-10 flex justify-center">
    <Button href="/the-cozelos-method/" variant="secondary" size="lg" icon="arrow">See the Cozelos Method</Button>
  </div>
</Section>
